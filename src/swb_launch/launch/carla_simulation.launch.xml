<?xml version="1.0" encoding="UTF-8"?>
<!--
  The simulation side on CARLA (roadmap 046): the CARLA world server, the scenario bridge
  driving it, and the agent relay, in one launch: one process group, one stop
  (docs/roadmap/046, "Process lifetime"). CARLA itself is started apart (`just carla-start`),
  long-lived.

    play_launch launch FLAGS swb_launch carla_simulation.launch.xml [carla_host:=localhost]
        [carla_port:=2000] [world_port:=5591] [ssv2_port:=5555] [agent_port:=5560]
        [weather:=ClearNoon] [gap_trace_dir:=DIR] [npc_contact_sensors:=false]

  The bridge's timeouts sit above CARLA's own watchdogs (roadmap 034: a tick 45 s, a spawn
  75 s, an Initialize 280 s), so a hung CARLA call is reported by the world server first,
  which then ends (75) and is restarted; the bridge follows.
-->
<launch>
  <arg name="carla_host" default=""/>
  <arg name="carla_port" default=""/>
  <arg name="world_port" default="5591" description="the CARLA world server's port on 127.0.0.1"/>
  <arg name="carla_world_config" default="$(find-pkg-share carla_world)/config/carla_world.yaml"/>
  <arg name="config_file" default="$(find-pkg-share scenario_world_bridge)/config/bridge_config.yaml"/>
  <arg name="ssv2_port" default=""/>
  <arg name="entity" default="ego"/>
  <arg name="agent_port" default="5560"/>
  <arg name="npc_motion" default=""/>
  <arg name="weather" default=""/>
  <arg name="gap_trace_dir" default=""/>
  <arg name="contact_report_dir" default=""/>
  <arg name="npc_contact_sensors" default=""/>

  <!-- Scoped: a launch argument an include sets (config_file) would otherwise leak into the
       next one. -->
  <group>
  <include file="$(find-pkg-share carla_world)/launch/carla_world.launch.xml">
    <arg name="port" value="$(var world_port)"/>
    <arg name="config_file" value="$(var carla_world_config)"/>
    <arg name="carla_host" value="$(var carla_host)"/>
    <arg name="carla_port" value="$(var carla_port)"/>
    <arg name="ssv2_port" value="$(var ssv2_port)"/>
    <arg name="npc_contact_sensors" value="$(var npc_contact_sensors)"/>
  </include>
  </group>
  <include file="$(find-pkg-share swb_launch)/launch/simulation.launch.xml">
    <arg name="world_endpoint" value="tcp://127.0.0.1:$(var world_port)"/>
    <arg name="world_request_timeout_seconds" value="90"/>
    <arg name="world_load_timeout_seconds" value="300"/>
    <arg name="config_file" value="$(var config_file)"/>
    <arg name="ssv2_port" value="$(var ssv2_port)"/>
    <arg name="entity" value="$(var entity)"/>
    <arg name="agent_port" value="$(var agent_port)"/>
    <arg name="npc_motion" value="$(var npc_motion)"/>
    <arg name="weather" value="$(var weather)"/>
    <arg name="gap_trace_dir" value="$(var gap_trace_dir)"/>
    <arg name="contact_report_dir" value="$(var contact_report_dir)"/>
  </include>
</launch>
