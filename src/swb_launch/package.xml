<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swb_launch</name>
  <version>0.1.0</version>
  <description>Launch files for scenario-world-bridge demos</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>scenario_world_bridge</exec_depend>
  <exec_depend>scenario_agent_relay</exec_depend>
  <exec_depend>acb_bridge</exec_depend>
  <exec_depend>acb_launch</exec_depend>
  <exec_depend>acb_pilot</exec_depend>
  <exec_depend>scenario_test_runner</exec_depend>
  <!-- chase_view (demo camera window); it also needs the CARLA Python API: pip install carla==0.9.16 -->
  <exec_depend>python3-pygame</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
