<?xml version="1.0"?>
<!--
	Town01: a blind NPC catches the ego from behind in its lane and makes contact. Exists to
	compare SSv2's CollisionCondition with CARLA's collision sensor (roadmap 014, "Collision
	truth"). Town01 has one lane per direction, so a lateral cut-in is not possible; a rear
	contact exercises the same comparison. The ego starts as in town01_ego_drive.xosc
	(westbound, y = -130); the NPC starts 25 m behind it and runs at 8 m/s against the ego's
	~4 m/s, and brakes at 8 m/s2 once it has hit the ego. Success = SSv2 saw the collision (the
	exit waits 1 s so the bodies stay in contact long enough for CARLA to tick with them
	touching (ending on the first frame of overlap ended the run before csb had applied the
	overlapping pose), and no longer: the hit shoves the ego to ~9 m/s, and the 3 s this
	waited until 2026-10-16 carried it 23 m down the road to lamp pole CityLamp121, which it
	hit whenever it yawed a little left (roadmap 032 N4). 1 s ends the run while CARLA still
	reports the contact (it does for ~1.3 s), so csb is still holding npc_rear back on the
	last frame; an end just after that hold, where SSv2's blind NPC still overlaps the ego
	by ~0.5 m, is a one-frame G1 of its own. Failure = 120 s with no collision.
	Both cars declare the box of the body they get, vehicle.tesla.model3 (4.792 x 2.163 x
	1.488 m, centre 1.532 m ahead of the rear axle): with the old 4.5 m boxes CARLA's bodies
	met ~0.3 m before SSv2's did, a one-frame G1 at the contact onset (roadmap 032 N7).
	The contact is the point, so csbExpectedContacts declares it: run_suite
	physical-verdict accepts the contact with npc_rear, and fails on any other contact.
-->
<OpenSCENARIO>
	<FileHeader author="carla-scenario-bridge" date="2026-10-05T00:00:00+00:00" description="Town01 rear contact by a blind NPC, for the collision-truth comparison" revMajor="1" revMinor="2" />
	<ParameterDeclarations>
		<ParameterDeclaration name="csbExpectedContacts" parameterType="string" value="npc_rear" />
	</ParameterDeclarations>
	<CatalogLocations />
	<RoadNetwork>
		<LogicFile filepath="$(env CARLA_MAPS)/Town01" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
				<BoundingBox>
					<Center x="1.532" y="0.0" z="0.744" />
					<Dimensions width="2.163" height="1.488" length="4.792" />
				</BoundingBox>
				<Performance maxSpeed="50" maxAcceleration="15.0" maxDeceleration="15.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
					<RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
				</Axles>
				<Properties />
			</Vehicle>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
		<ScenarioObject name="npc_rear">
			<Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
				<BoundingBox>
					<Center x="1.532" y="0.0" z="0.744" />
					<Dimensions width="2.163" height="1.488" length="4.792" />
				</BoundingBox>
				<Performance maxSpeed="20" maxAcceleration="5.0" maxDeceleration="8.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
					<RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
				</Axles>
				<Properties />
			</Vehicle>
			<ObjectController>
				<Controller name="">
					<Properties>
						<!-- Blind: the NPC does not slow for what is ahead, so it reaches the ego. -->
						<Property name="isBlind" value="true" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init>
			<Actions>
				<Private entityRef="ego">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="190.8" y="-130.1" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
					<PrivateAction>
						<RoutingAction>
							<AcquirePositionAction>
								<Position>
									<WorldPosition x="120.0" y="-129.8" z="0.0" h="3.14159" p="0" r="0" />
								</Position>
							</AcquirePositionAction>
						</RoutingAction>
					</PrivateAction>
				</Private>
				<Private entityRef="npc_rear">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="215.8" y="-130.1" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
				</Private>
			</Actions>
		</Init>
		<Story name="town01_rear_contact">
			<Act name="contact_act">
				<ManeuverGroup maximumExecutionCount="1" name="npc_group">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="npc_rear" />
					</Actors>
					<Maneuver name="npc_maneuver">
						<Event name="npc_go" priority="parallel">
							<Action name="npc_speed">
								<PrivateAction>
									<LongitudinalAction>
										<SpeedAction>
											<SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" />
											<SpeedActionTarget>
												<AbsoluteTargetSpeed value="8.0" />
											</SpeedActionTarget>
										</SpeedAction>
									</LongitudinalAction>
								</PrivateAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="npc_start" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="2" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<!-- Once it has hit the ego the NPC brakes, as a driver would. Without this a
						     blind NPC keeps driving at 8 m/s through the ego's pose for the 3 s the
						     run lasts after the contact, and in CARLA, where bodies push, that
						     shoves the ego down the road (into a pole, twice in 2026-10-12 runs). -->
						<Event name="npc_brake" priority="parallel">
							<Action name="npc_stop">
								<PrivateAction>
									<LongitudinalAction>
										<SpeedAction>
											<SpeedActionDynamics dynamicsShape="linear" value="8.0" dynamicsDimension="rate" />
											<SpeedActionTarget>
												<AbsoluteTargetSpeed value="0.0" />
											</SpeedActionTarget>
										</SpeedAction>
									</LongitudinalAction>
								</PrivateAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="npc_hit_ego" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="npc_rear" />
											</TriggeringEntities>
											<EntityCondition>
												<CollisionCondition>
													<EntityRef entityRef="ego" />
												</CollisionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<ManeuverGroup maximumExecutionCount="1" name="end_group">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="ego" />
					</Actors>
					<Maneuver name="end_conditions">
						<Event name="collision_seen" priority="parallel">
							<Action name="exit_success">
								<UserDefinedAction>
									<CustomCommandAction type="exitSuccess" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="ssv2_collision" delay="1.0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="npc_rear" />
											</TriggeringEntities>
											<EntityCondition>
												<CollisionCondition>
													<EntityRef entityRef="ego" />
												</CollisionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure">
								<UserDefinedAction>
									<CustomCommandAction type="exitFailure" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="timeout_condition" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="120" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
