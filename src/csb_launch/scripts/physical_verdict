#!/usr/bin/env python3
"""Join CARLA's contacts into a scenario's JUnit verdict (roadmap 021).

    ros2 run csb_launch physical_verdict <result.junit.xml> [--scenario FILE]
        [--contacts DIR] [--since T] [--until T] [--min-impulse N]

SSv2 judges collisions in its own geometry and cannot see what CARLA's physics did: the
ego hitting a curb, a pole, or an NPC body larger than its declared box passes. The bridge
writes each ego run's CARLA contacts to `<contact_report_dir>` (default
`$ROS_HOME/csb/contacts`); this adds one testcase, `carla_contact`, to the JUnit file in
place, next to SSv2's own testcases (which are never edited):

  - pass:    every report in the window is complete and has no unexpected contact
  - failure: a contact the scenario did not declare (entity, first frame, max impulse)
  - error:   no report in the window, or one cut short by a CARLA restart

The window is [--since, --until] on each report's ego spawn time (Unix seconds or ISO 8601);
without either, the newest report alone is judged. A scenario that means to collide says so
with `<ParameterDeclaration name="csbExpectedContacts" parameterType="string"
value="npc_rear"/>` (comma-separated entity names; `static` allows the static world); pass
--scenario so it is read, and so a scenario with no ego (no entity with isEgo=true or
SSv2's Autoware controller) passes without a report.

Several reports in the window (a YAML scenario's variants) still make one testcase; its
message numbers each as "run i/N".

Exit status: 0 if the added testcase passed, 1 if not, 2 on a usage error.
"""

import argparse
import datetime
import importlib.machinery
import importlib.util
import json
import os
import sys
import time
import xml.etree.ElementTree as ET
from pathlib import Path
from typing import List, Optional, Set, Tuple

SCHEMA = 1
TESTCASE = "carla_contact"
EXPECTED_PARAM = "csbExpectedContacts"
STATIC = "static"


def _run_suite():
    """run_suite's scenario readers, loaded from the script next to this one."""
    path = Path(__file__).resolve().parent / "run_suite"
    loader = importlib.machinery.SourceFileLoader("csb_run_suite", str(path))
    spec = importlib.util.spec_from_loader("csb_run_suite", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# ---------------------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------------------


def default_contacts_dir() -> Path:
    """Where the bridge writes by default: $ROS_HOME/csb/contacts, else ~/.ros/csb/contacts."""
    ros_home = os.environ.get("ROS_HOME") or str(Path.home() / ".ros")
    return Path(ros_home) / "csb" / "contacts"


def parse_time(text: str) -> float:
    """Unix seconds, or an ISO 8601 time (naive = local time)."""
    try:
        return float(text)
    except ValueError:
        pass
    t = datetime.datetime.fromisoformat(text.replace("Z", "+00:00"))
    return t.timestamp()


def load_reports(directory: Path, since: Optional[float] = None,
                 until: Optional[float] = None) -> List[dict]:
    """Reports whose ego spawn time lies in [since, until], oldest first. Without either
    bound, the newest report alone. Unreadable files and unknown schemas are skipped with a
    note on stderr."""
    if not directory.is_dir():
        return []
    reports = []
    for path in sorted(directory.glob("*.json")):
        try:
            report = json.loads(path.read_text())
        except (OSError, ValueError) as e:
            print(f"[physical_verdict] skipping unreadable {path}: {e}", file=sys.stderr)
            continue
        if report.get("schema") != SCHEMA:
            print(f"[physical_verdict] skipping {path}: schema {report.get('schema')!r}, "
                  f"this tool reads {SCHEMA}", file=sys.stderr)
            continue
        report["_path"] = str(path)
        reports.append(report)
    reports.sort(key=lambda r: r.get("start_unix", 0.0))
    if since is None and until is None:
        return reports[-1:]
    lo = since if since is not None else float("-inf")
    hi = until if until is not None else float("inf")
    return [r for r in reports if lo <= r.get("start_unix", 0.0) <= hi]


# ---------------------------------------------------------------------------------------
# What the scenario declares
# ---------------------------------------------------------------------------------------


def _split(value) -> Set[str]:
    return {n.strip() for n in str(value or "").split(",") if n.strip()}


def expected_contacts(scenario: Path) -> Set[str]:
    """Entity names (and possibly `static`) from the scenario's csbExpectedContacts."""
    if scenario.suffix == ".xosc":
        root = ET.parse(scenario).getroot()
        names: Set[str] = set()
        for p in root.iter("ParameterDeclaration"):
            if p.get("name") == EXPECTED_PARAM:
                names |= _split(p.get("value"))
        return names

    import yaml  # ROS ships PyYAML; only needed for YAML scenarios

    found: Set[str] = set()

    def walk(node):
        if isinstance(node, dict):
            if node.get("name") == EXPECTED_PARAM:
                found.update(_split(node.get("value")))
            for value in node.values():
                walk(value)
        elif isinstance(node, list):
            for item in node:
                walk(item)

    walk(yaml.safe_load(scenario.read_text()))
    return found


def scenario_has_ego(scenario: Path) -> bool:
    """True when the scenario has an ego (isEgo=true, or SSv2's Autoware controller)."""
    rs = _run_suite()
    objects = rs._objects_xml(scenario) if scenario.suffix == ".xosc" else rs._objects_yaml(scenario)
    return any(is_ego or ctrl == rs.EGO_CONTROLLER for _, ctrl, is_ego in objects)


# ---------------------------------------------------------------------------------------
# The verdict
# ---------------------------------------------------------------------------------------


def _clock(unix: float) -> str:
    return datetime.datetime.fromtimestamp(unix, datetime.timezone.utc).strftime("%H:%M:%SZ")


def judge(reports: List[dict], expected: Set[str] = frozenset(), min_impulse: float = 0.0,
          has_ego: bool = True) -> Tuple[str, str, str]:
    """(kind, type, message) for the carla_contact testcase: kind is pass | failure | error."""
    if not has_ego:
        return "pass", "", "no ego in scenario"
    if not reports:
        return ("error", "NoContactReport",
                "no contact report from the bridge in the run window (contact_report_dir "
                "off, collision_monitor off, or a different bridge?)")
    lines = []
    for i, r in enumerate(reports, 1):
        where = f"run {i}/{len(reports)} (ego '{r.get('ego')}' spawned {_clock(r.get('start_unix', 0))})"
        for c in r.get("contacts", []):
            is_static = bool(c.get("static"))
            name = c.get("name")
            if (STATIC if is_static else name) in expected:
                continue
            if c.get("max_impulse", 0.0) < min_impulse:
                continue
            if is_static:
                who = "static world"
            elif name:
                who = f"'{name}' ({c.get('type') or '?'})"
            else:
                who = f"unknown actor {c.get('other_id')} ({c.get('type') or '?'})"
            lines.append(
                f"{where}: ego hit {who} at SSv2 frame {c.get('first_ssv2_frame')} "
                f"(t={c.get('first_sim_time', 0.0):.2f} s), {c.get('count')} contact(s), "
                f"max impulse {c.get('max_impulse', 0.0):.1f} N*s")
    if lines:
        return ("failure", "CarlaContact",
                f"CARLA saw {len(lines)} contact(s) the scenario did not declare:\n"
                + "\n".join(lines))
    incomplete = [r for r in reports if not r.get("complete", True)]
    if incomplete:
        return ("error", "IncompleteContactReport",
                f"CARLA restarted mid-run; contact record incomplete "
                f"({len(incomplete)} of {len(reports)} run(s))")
    return "pass", "", f"{len(reports)} run(s), no unexpected contact"


def classname_of(junit_root: ET.Element) -> str:
    suite = junit_root.find("testsuite") if junit_root.tag == "testsuites" else junit_root
    return suite.get("name", "") if suite is not None else ""


def apply_to_junit(junit: Path, kind: str, type_: str, message: str) -> None:
    """Add (or replace) the carla_contact testcase in the file's first testsuite and keep
    the counts on testsuite and testsuites right. SSv2's testcases are left alone."""
    tree = ET.parse(junit)
    root = tree.getroot()
    suite = root.find("testsuite") if root.tag == "testsuites" else root
    if suite is None:
        suite = ET.SubElement(root, "testsuite", name=junit.parent.parent.name)
    for old in suite.findall("testcase"):
        if old.get("name") == TESTCASE:
            suite.remove(old)
    tc = ET.SubElement(suite, "testcase", name=TESTCASE)
    if kind == "pass":
        out = ET.SubElement(tc, "system-out")
        out.text = message
    else:
        el = ET.SubElement(tc, kind, type=type_, message=message.splitlines()[0])
        el.text = message
    for node in [suite] + ([root] if root is not suite else []):
        cases = list(suite.iter("testcase"))
        node.set("tests", str(len(cases)))
        node.set("failures", str(sum(c.find("failure") is not None for c in cases)))
        node.set("errors", str(sum(c.find("error") is not None for c in cases)))
    if hasattr(ET, "indent"):
        ET.indent(root, "  ")
    tree.write(junit, encoding="utf-8", xml_declaration=True)


def verdict_for_run(scenario: Optional[Path], contacts_dir: Path, since: Optional[float],
                    until: Optional[float], min_impulse: float = 0.0,
                    wait: float = 3.0) -> Tuple[str, str, str]:
    """Read the scenario and the reports and judge. Waits up to `wait` s for a report the
    bridge's writer thread may still be finishing when the scenario has just ended."""
    expected: Set[str] = set()
    has_ego = True
    if scenario is not None:
        try:
            expected = expected_contacts(scenario)
            has_ego = scenario_has_ego(scenario)
        except Exception as e:  # noqa: BLE001 -- judged without the scenario's word
            print(f"[physical_verdict] could not read {scenario} ({e}); judging with no "
                  "expected contacts", file=sys.stderr)
    deadline = time.monotonic() + wait
    reports = load_reports(contacts_dir, since, until)
    while has_ego and not reports and time.monotonic() < deadline:
        time.sleep(0.2)
        reports = load_reports(contacts_dir, since, until)
    return judge(reports, expected, min_impulse, has_ego)


def main(argv: Optional[List[str]] = None) -> int:
    ap = argparse.ArgumentParser(
        prog="physical_verdict",
        description="Add a carla_contact testcase to an SSv2 result.junit.xml from the "
                    "bridge's contact reports.")
    ap.add_argument("junit", type=Path, help="SSv2 result.junit.xml, edited in place")
    ap.add_argument("--scenario", type=Path,
                    help="the scenario file: its csbExpectedContacts, and whether it has an ego")
    ap.add_argument("--contacts", type=Path, default=default_contacts_dir(), metavar="DIR",
                    help=f"bridge contact_report_dir (default {default_contacts_dir()})")
    ap.add_argument("--since", type=parse_time, metavar="T",
                    help="window start: Unix seconds or ISO 8601")
    ap.add_argument("--until", type=parse_time, metavar="T", help="window end")
    ap.add_argument("--min-impulse", type=float, default=0.0, metavar="N",
                    help="ignore contacts below this normal impulse, N*s (default 0)")
    args = ap.parse_args(sys.argv[1:] if argv is None else argv)
    if not args.junit.is_file():
        print(f"[physical_verdict] no such file: {args.junit}", file=sys.stderr)
        return 2
    kind, type_, message = verdict_for_run(args.scenario, args.contacts, args.since,
                                           args.until, args.min_impulse)
    apply_to_junit(args.junit, kind, type_, message)
    print(f"[physical_verdict] {TESTCASE}: {kind.upper()} -- {message}")
    return 0 if kind == "pass" else 1


if __name__ == "__main__":
    sys.exit(main())
