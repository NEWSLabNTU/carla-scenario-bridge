<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>csb_agent</name>
  <version>0.1.0</version>
  <description>
    The agent SDK (roadmap 030): one Python interface, csb_agent.Agent, for any autopilot
    driving carla-scenario-bridge scenarios through the agent relay, and the agent
    protocol both ends import. Standard library only; ROS optional.
  </description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- Only csb_agent.ros and ros_adapter use ROS; the SDK core is standard library. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
