<launch>
  <!--
    Autoware + acb_bridge for the scenario ego.

    Same stack, same structure as background_av.launch.xml; the differences are exactly
    the ego's domain and clock policy:

    - No ROS_DOMAIN_ID override in this file: this stack must live in SSv2's domain,
      which is ambient in the caller's environment. SSv2's concealer (launched with
      launch_autoware:=false) reaches this Autoware over plain ROS topics/services to
      initialize, route, and engage it — a stack in any other domain is invisible to it.
      `just ego-av` and `just scenario` therefore export the same ROS_DOMAIN_ID
      (default 1, `ego_domain` in the justfile). Domain 0 is left free on purpose: it
      is where every unconfigured ROS process on the host lands, and a stray node there
      would join the scenario's graph uninvited.

    - publish_clock is false here and true for background AVs: SSv2's traffic_simulator
      publishes /clock in this domain, and a second publisher makes localization log
      "Detected jump back in time. Clearing TF buffer". See
      docs/design/multi-instance-architecture.md.

      play_launch launch csb_launch ego_av.launch.xml map_path:=/path/to/Town01

    Start this BEFORE the scenario launch and wait for Autoware's ADAPI to come up: the
    concealer's constructor queues a ChangeToStop call with a 180 s service timeout, so
    a late ego stack fails slowly and confusingly. The stack is long-lived — SSv2 forks
    nothing and kills nothing, so one ego stack serves consecutive scenario runs.
  -->
  <arg name="map_path" description="Directory with lanelet2_map.osm and pointcloud_map.pcd" />
  <!-- Default "hero": SSv2 spawns the ego with role_name "hero", unlike background AVs
       whose names come from bridge_config.yaml. -->
  <arg name="vehicle_name" default="hero" description="CARLA role_name of the ego vehicle" />
  <arg name="carla_host" default="localhost" />
  <arg name="carla_port" default="2000" />
  <arg name="vehicle_model" default="acb_vehicle" />
  <arg name="sensor_model" default="acb_sensor_kit" />
  <arg name="launch_rviz" default="false" />

  <!-- managed=true  (default, phase 012): SSv2's concealer drives this ego's autonomy, so
                     the stack must share SSv2's ROS domain and must NOT publish /clock,
                     because SSv2 already does and a second publisher makes localization
                     log backwards jumps.
       managed=false (phase 013): the concealer is inert (`managed_ego:=false` on the fork),
                     nothing in SSv2 routes or engages this ego, and the stack becomes an
                     ordinary AV: its own domain, its own /clock, driven by acb_pilot from
                     `goal_poses_file`. Domain and clock are then policy, not a special case.

       The default preserves 012 exactly; nothing changes for a managed run. -->
  <arg name="managed" default="true"
       description="true: SSv2's concealer drives the ego. false: acb_pilot does, as for a background AV." />
  <arg name="goal_poses_file" default=""
       description="Ego goal in acb_pilot format. Required when managed:=false; unused otherwise." />
  <arg name="pilot_timeout" default="600.0" />
  <arg name="pilot_stabilize_seconds" default="15.0" />
  <arg name="pilot_route_timeout" default="120.0" />
  <!-- Derived from `managed` by `just ego-av`, which is the interface people use: a managed
       ego must not publish /clock (SSv2 does), an unmanaged one must (nothing else will).
       Left as an argument rather than computed here because the XML frontend has no
       conditional expression, and duplicating the ten-argument acb_bridge include across two
       <group> blocks to fake one would be worse than stating it. -->
  <arg name="publish_clock" default="false"
       description="false for a managed ego (SSv2 owns /clock), true for an unmanaged one" />
  <!-- Whether acb reports the wheel angle it measured, or echoes the command.
       Echoing (false, acb's default) leaves no actuator inside the loop MPC
       closes, while the CARLA wheel measurably lags the command by ~0.5 s.
       Exposed here so the two can be compared; see acb docs/issues/016. -->
  <arg name="report_measured_steering" default="false" />
  <!-- Trim on the steering command. 1.0 is right for the blueprints measured so far; the
       Ackermann inverse acb applies comes from physics_control, so a blueprint whose tyres
       or steering curve differ from its geometry can still under- or over-steer against it.
       Calibrate against measured wheel angles, not scenario outcomes. -->
  <arg name="steering_multiplier" default="1.0" />
  <!-- Report CARLA's actors as perception output instead of running the LiDAR pipeline.
       For debugging planning or control without perception in the loop. Set `perception`
       false as well, or Autoware's own prediction node publishes the same topic. -->
  <arg name="seed_localization_on_attach" default="true" />
  <arg name="publish_ground_truth_objects" default="false" />
  <arg name="ground_truth_range_m" default="100.0" />
  <arg name="control_trace_path" default="" />
  <arg name="accel_map_path" default="$(find-pkg-share acb_vehicle_description)/config/accel_map.csv" />
  <arg name="brake_map_path" default="$(find-pkg-share acb_vehicle_description)/config/brake_map.csv" />
  <!-- clustering = CPU-only rule-based lidar detection. This host shares its GPU;
       CARLA takes what headroom there is and centerpoint's TensorRT engine does
       not fit beside it. -->
  <arg name="lidar_detection_model" default="clustering" />
  <arg name="occupancy_grid_map_method" default="laserscan_based" />

  <!-- 1. Autoware — the same CARLA-tuned configuration SSv2's concealer used to fork -->
  <include file="$(find-pkg-share acb_launch)/launch/carla_simulator.launch.xml">
    <arg name="map_path" value="$(var map_path)" />
    <arg name="vehicle_model" value="$(var vehicle_model)" />
    <arg name="sensor_model" value="$(var sensor_model)" />
    <arg name="rviz" value="$(var launch_rviz)" />
    <arg name="lidar_detection_model" value="$(var lidar_detection_model)" />
    <arg name="occupancy_grid_map_method" value="$(var occupancy_grid_map_method)" />
    <!-- The acb vehicle interface would start a second acb_bridge with
         publish_clock=true (its default). Two bridges mean two /clock
         publishers and doubled sensor streams: subscribers see time jump
         backwards and zero-dt message pairs, which crashes
         gyro_bias_estimator ("dt_pose or dt_gyro is zero") and leaves its
         diagnostic stale-ERROR in the autonomous-mode gate. The bridge is
         launched once, explicitly, below. -->
    <arg name="launch_vehicle_interface" value="false" />
  </include>

  <!-- 2. acb_bridge for the ego. See `publish_clock` above for who owns the clock. -->
  <include file="$(find-pkg-share acb_bridge)/launch/acb_bridge.launch.xml">
    <arg name="carla_address" value="$(var carla_host)" />
    <arg name="carla_port" value="$(var carla_port)" />
    <arg name="vehicle_name" value="$(var vehicle_name)" />
    <arg name="publish_clock" value="$(var publish_clock)" />
    <arg name="report_measured_steering" value="$(var report_measured_steering)" />
    <arg name="steering_multiplier" value="$(var steering_multiplier)" />
    <arg name="seed_localization_on_attach" value="$(var seed_localization_on_attach)" />
    <arg name="publish_ground_truth_objects" value="$(var publish_ground_truth_objects)" />
    <arg name="ground_truth_range_m" value="$(var ground_truth_range_m)" />
    <arg name="control_trace_path" value="$(var control_trace_path)" />
    <arg name="accel_map_path" value="$(var accel_map_path)" />
    <arg name="brake_map_path" value="$(var brake_map_path)" />
  </include>

  <!-- 3. The tier4 external API adaptor. SSv2's concealer calls
       /api/autoware/set/velocity_limit (a 180 s service timeout, then
       AutowareError) and nothing in the acb Autoware profile provides it.

       Launched OUTSIDE this file for now (see `just ego-av`): with the adaptor
       inside this ~50-process launch, the concealer repeatedly failed to match
       its service within 180 s (observed under both multicast and
       loopback-unicast CycloneDDS configs), while a standalone adaptor process
       was matched promptly. Cause not yet understood - suspected discovery
       scaling on a host with lo-multicast disabled. -->
  <!-- 4. The pilot, for unmanaged runs only. It stands in for the concealer exactly as it
       does in every background AV's domain: waits for localization, sets the route from
       `goal_poses_file`, engages. In a managed run the concealer does this and the pilot
       must not run, since two things engaging one ego is the same class of mistake as two
       /clock publishers. -->
  <group unless="$(var managed)">
    <node pkg="acb_pilot" exec="auto_drive" name="auto_drive" output="screen">
      <param name="poses_file" value="$(var goal_poses_file)" />
      <param name="timeout" value="$(var pilot_timeout)" />
      <param name="stabilize_seconds" value="$(var pilot_stabilize_seconds)" />
      <param name="route_timeout" value="$(var pilot_route_timeout)" />
      <param name="use_sim_time" value="true" />
    </node>
  </group>

  <arg name="launch_api_adaptor" default="false" />
  <group if="$(var launch_api_adaptor)">
    <include file="$(find-pkg-share autoware_iv_external_api_adaptor)/launch/external_api_adaptor.launch.py" />
  </group>
</launch>
