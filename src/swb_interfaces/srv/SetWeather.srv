# Set the world's weather, by preset or by parameters (roadmap 051: the names are the world
# server's -- CARLA's presets and WeatherParameters fields, listed in swb_carla_world's README).
# The world server keeps it and applies it again after every world load.
#
#   ros2 service call /scenario_world_bridge/set_weather swb_interfaces/srv/SetWeather "{preset: ClearNoon}"
#   ros2 service call /scenario_world_bridge/set_weather swb_interfaces/srv/SetWeather
#     "{names: [cloudiness, sun_altitude_angle], values: [30.0, 60.0]}"

# A preset by the world server's name for it; takes precedence over the parameters.
string preset
# Parameters by name, one value each; those not named keep their current values. An empty
# request (no preset, no names) is refused.
string[] names
float64[] values
---
bool success
string message
# The weather now: the preset it matches (empty if none) and every parameter the server has.
string preset
string[] names
float64[] values
