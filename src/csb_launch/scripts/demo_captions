#!/usr/bin/env python3
"""Caption strip for the 033 demo tour.

Subscribes to SSv2's storyboard state (`/simulation/context`, openscenario_interpreter_msgs/
Context: one JSON snapshot of the whole storyboard per frame) and to the entities' state
(`/simulation/entity/status`), both in the scenario domain (9), and shows in a small window:

  - when an incident starts (its `<group>_start` event completes): its title;
  - while it runs: the ego's speed and gap to the incident's actors;
  - when it ends (`<group>_end`, or its watchdog): how Autoware handled it -- stopped or
    slowed, the smallest gap to the actors, how long the ego stood -- or that the watchdog
    cleared it;
  - a contact (`<actor>_contact`), in red;
  - at the goal: a closing caption with the tour's time and tally.

Events are matched by name (the tour's generator names them `<group>_start`, `<group>_end`,
`<group>_watchdog` / `_clear`, `<actor>_contact`; see scripts/gen_demo_incidents.py), and an
event counts once, when its state changes to completeState. Gaps are box to box, from the
entities' bounding boxes in SSv2's own state: the same numbers SSv2 judges by.

    ROS_DOMAIN_ID=9 ros2 run csb_launch demo_captions [--geometry 740x150+70+470] [--log FILE]

`--headless` prints the captions instead of opening a window (for logs and tests).
"""

import argparse
import json
import math
import sys
import threading
import time

# Incident titles by the group whose start opens it (the tour's route order). An incident with
# two groups (2: parked cars + pedestrian, 4: broken car + oncoming pair) opens on the one
# listed; its actors are every entity named i<N>_*.
INCIDENTS = {
    "i2_ped": (2, "Pedestrian darts out from behind a parked van"),
    "i1": (1, "Lead car brakes hard"),
    "i3": (3, "Red light"),
    "i4_broken": (4, "Blocked lane: a broken-down car"),
    "i5": (5, "Crossing traffic at a left turn"),
    "i6": (6, "Cyclist on the inside of a right turn"),
}
# The event that ends each incident, and its watchdog's.
ENDS = {
    "i2_ped": ("i2_ped_end", "i2_ped_watchdog"),
    "i1": ("i1_end", "i1_watchdog"),
    "i3": ("i3_green", "i3_watchdog"),
    "i4_broken": ("i4_broken_end", "i4_broken_clear"),
    "i5": ("i5_end", "i5_watchdog"),
    "i6": ("i6_end", "i6_watchdog"),
}
START_EVENT = {"i3": "i3_red"}  # incident 3 has no actors: the red is its start
# The actors the gap is measured to (an incident's other actors, e.g. incident 4's oncoming pair,
# pass by and are not what the ego handles).
ACTORS = {1: "i1_lead", 2: "i2_ped", 4: "i4_broken", 5: "i5_cross", 6: "i6_cyclist"}
STILL_MPS = 0.1


def completed_events(data):
    """{event name: (state, execution count)} from one /simulation/context JSON snapshot"""
    out = {}

    def walk(node):
        if isinstance(node, dict):
            if "Event" in node:
                evs = node["Event"]
                for e in evs if isinstance(evs, list) else [evs]:
                    if isinstance(e, dict) and "name" in e:
                        out[e["name"]] = (e.get("currentState"), e.get("currentExecutionCount"))
            for v in node.values():
                if isinstance(v, (dict, list)):
                    walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)

    walk(data)
    return out


def box_gap(a, b):
    """freespace distance between two oriented boxes (x, y, yaw, length, width, cx, cy), metres;
    0 when they overlap. Sampled on the boxes' outlines: plenty for a caption."""
    def corners(e):
        x, y, h, l, w, cx, cy = e
        c, s = math.cos(h), math.sin(h)
        ox, oy = x + c * cx - s * cy, y + s * cx + c * cy
        return [(ox + c * dx - s * dy, oy + s * dx + c * dy)
                for dx, dy in ((l / 2, w / 2), (l / 2, -w / 2), (-l / 2, -w / 2), (-l / 2, w / 2))]

    def inside(p, poly):
        sgn = None
        for (x1, y1), (x2, y2) in zip(poly, poly[1:] + poly[:1]):
            cr = (x2 - x1) * (p[1] - y1) - (y2 - y1) * (p[0] - x1)
            if sgn is None:
                sgn = cr >= 0
            elif (cr >= 0) != sgn:
                return False
        return True

    def seg_d(p, a1, a2):
        vx, vy = a2[0] - a1[0], a2[1] - a1[1]
        t = max(0.0, min(1.0, ((p[0] - a1[0]) * vx + (p[1] - a1[1]) * vy) / max(vx * vx + vy * vy, 1e-9)))
        return math.hypot(p[0] - a1[0] - t * vx, p[1] - a1[1] - t * vy)

    pa, pb = corners(a), corners(b)
    if any(inside(p, pb) for p in pa) or any(inside(p, pa) for p in pb):
        return 0.0
    d = min(seg_d(p, q1, q2) for p in pa for q1, q2 in zip(pb, pb[1:] + pb[:1]))
    return min(d, min(seg_d(p, q1, q2) for p in pb for q1, q2 in zip(pa, pa[1:] + pa[:1])))


class Incident:
    def __init__(self, group, n, title, t):
        self.group, self.n, self.title, self.t0 = group, n, title, t
        self.min_gap = None
        self.min_v = None
        self.stood = 0.0
        self.contact = False
        self.prefix = ACTORS.get(n, f"i{n}_")

    def outcome(self, how):
        if how == "watchdog":
            return "cleared by the watchdog: the ego stood too long"
        gap = f"{self.min_gap:.1f} m" if self.min_gap is not None else "?"
        n, stood = self.n, self.stood
        if n == 3:
            text = f"Autoware stopped at the line and went on green after {stood:.0f} s"
        elif stood >= 0.5:
            text = {
                2: f"Autoware braked and stopped {gap} short of the pedestrian",
                1: f"Autoware stopped {gap} behind the braking car",
                4: f"Autoware stopped {gap} behind it, waited {stood:.0f} s until the tow truck cleared it",
                5: f"Autoware yielded to both cars ({stood:.0f} s), then turned",
                6: f"Autoware yielded ({stood:.1f} s) and let the cyclist through on its inside",
            }.get(n, f"Autoware stopped, closest {gap}")
        elif self.min_v is not None and self.min_v < 5.0:
            text = f"Autoware slowed to {self.min_v * 3.6:.0f} km/h, closest {gap}"
        else:
            text = f"Autoware kept going, closest {gap}"
        return text + (" -- CONTACT" if self.contact else "")


class Captions:
    def __init__(self, emit):
        self.emit = emit  # emit(headline, detail, colour)
        self.seen = {}
        self.active = {}
        self.tally = []  # (n, title, outcome)
        self.t_start = None
        self.last_t = None
        self.contacts = 0
        self.still_for = 0.0
        self.closed = False
        self.live = ""  # one line: the ego's speed, and the gap to the active incident's actor

    def on_context(self, data, sim_t):
        events = completed_events(data)
        if self.t_start is None and sim_t is not None and sim_t == sim_t:
            self.t_start = sim_t
        for name, (state, count) in events.items():
            key = (state, count)
            if self.seen.get(name) == key:
                continue
            self.seen[name] = key
            if state == "runningState" and name == "goal_reached":
                # the goal's exit ends the interpreter in the same frame: its completeState
                # may never be published
                self.on_complete(name, sim_t)
            if state != "completeState":
                continue
            self.on_complete(name, sim_t)

    def on_complete(self, name, t):
        for group, (n, title) in INCIDENTS.items():
            if name == START_EVENT.get(group, f"{group}_start") and group not in self.active:
                self.active[group] = Incident(group, n, title, t)
                self.emit(f"Incident {len(self.tally) + 1} of 6: {title}", "", "#f0c040")
                return
            end, watchdog = ENDS[group]
            if name in (end, watchdog) and group in self.active:
                inc = self.active.pop(group)
                how = "watchdog" if name.endswith("_watchdog") else ("clear" if name.endswith("_clear") else "end")
                out = inc.outcome(how)
                self.tally.append((inc.n, title, out, how))
                self.emit(title, out,
                          "#e04040" if inc.contact or how == "watchdog" else "#60d060")
                return
        if name.endswith("_contact"):
            actor = name[: -len("_contact")]
            self.contacts += 1
            for inc in self.active.values():
                if actor.startswith(inc.prefix):
                    inc.contact = True
            if actor.startswith("i"):
                self.emit(f"Contact with {actor}", "logged; the tour goes on", "#e04040")
            return
        if name == "goal_reached" and not self.closed:
            self.closed = True
            dur = (t - self.t_start) if (t is not None and self.t_start is not None) else None
            ok = sum(1 for x in self.tally if x[3] != "watchdog")
            self.emit("Tour complete: goal reached",
                      f"{ok} of {len(self.tally)} incidents handled, {self.contacts} contacts"
                      + (f", {dur / 60:.1f} min" if dur else ""), "#60a0ff")

    def on_status(self, entities, t):
        """entities: {name: (x, y, yaw, length, width, cx, cy, speed)}"""
        ego = entities.get("ego")
        if ego is None:
            return
        # SSv2 reports NaN for the time before the scenario starts: no time passes then
        # (min() with a NaN returns its other argument, which once counted 0.5 s a message)
        if t is None or t != t:
            t = None
        dt = 0.0 if self.last_t is None or t is None else max(0.0, min(0.5, t - self.last_t))
        self.last_t = t
        v = abs(ego[7])
        live = f"ego {v * 3.6:4.0f} km/h"
        for inc in self.active.values():
            inc.min_v = v if inc.min_v is None else min(inc.min_v, v)
            if v < STILL_MPS:
                inc.stood += dt
            near = None
            for name, e in entities.items():
                if name.startswith(inc.prefix):
                    g = box_gap(ego[:7], e[:7])
                    inc.min_gap = g if inc.min_gap is None else min(inc.min_gap, g)
                    near = g if near is None else min(near, g)
            if near is not None:
                live += f"   gap {near:5.1f} m"
        if v < STILL_MPS:
            self.still_for += dt
            if self.still_for > 0.5:
                live += f"   stopped {self.still_for:4.1f} s"
        else:
            self.still_for = 0.0
        self.live = live


def entities_of(msg):
    out = {}
    for s in msg.data:
        st = s.status
        p = st.pose.position
        q = st.pose.orientation
        yaw = math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z))
        bb = st.bounding_box
        out[st.name] = (p.x, p.y, yaw, bb.dimensions.x, bb.dimensions.y, bb.center.x, bb.center.y,
                        st.action_status.twist.linear.x)
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--geometry", default="740x150+70+470", help="Tk geometry WxH+X+Y")
    ap.add_argument("--font", type=int, default=20)
    ap.add_argument("--log", help="append every caption here (JSON lines)")
    ap.add_argument("--headless", action="store_true")
    ap.add_argument("--footer", default="Autoware 1.5 (CenterPoint)  |  CARLA 0.9.16  |  scenario_simulator_v2")
    a = ap.parse_args()

    import rclpy
    from rclpy.node import Node
    from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
    from openscenario_interpreter_msgs.msg import Context
    from traffic_simulator_msgs.msg import EntityStatusWithTrajectoryArray

    log = open(a.log, "a", buffering=1) if a.log else None
    ui = {}

    def emit(head, detail, colour):
        line = dict(wall=round(time.time(), 2), head=head, detail=detail)
        print(f"[demo_captions] {head}{' -- ' + detail if detail else ''}", flush=True)
        if log:
            log.write(json.dumps(line) + "\n")
        if "set" in ui:
            ui["set"](head, detail, colour)

    cap = Captions(emit)
    lock = threading.Lock()

    class N(Node):
        def __init__(self):
            super().__init__("demo_captions")
            tl = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL, reliability=ReliabilityPolicy.RELIABLE)
            self.create_subscription(Context, "/simulation/context", self.ctx, tl)
            self.create_subscription(EntityStatusWithTrajectoryArray, "/simulation/entity/status", self.status, 10)

        def ctx(self, m):
            if not m.data:
                return
            try:
                data = json.loads(m.data)
            except ValueError:
                return
            with lock:
                cap.on_context(data, m.time if m.time == m.time else None)

        def status(self, m):
            if not m.data:
                return
            t = m.data[0].status.time  # simulation time; the array has no header
            with lock:
                cap.on_status(entities_of(m), t)

    rclpy.init()
    node = N()
    if a.headless:
        try:
            rclpy.spin(node)
        except KeyboardInterrupt:
            pass
        return 0

    import tkinter as tk
    root = tk.Tk()
    root.title("demo captions")
    root.geometry(a.geometry)
    root.configure(bg="#101418")
    head = tk.Label(root, text="Demo tour: Autoware on CARLA, Town01, 40 km/h", fg="#e8e8e8", bg="#101418",
                    font=("DejaVu Sans", a.font, "bold"), anchor="w", justify="left", wraplength=int(a.geometry.split("x")[0]) - 20)
    head.pack(fill="x", padx=12, pady=(14, 4))
    detail = tk.Label(root, text="scenario_simulator_v2 incidents, CenterPoint perception", fg="#b0b8c0", bg="#101418",
                      font=("DejaVu Sans", int(a.font * 0.8)), anchor="w", justify="left",
                      wraplength=int(a.geometry.split("x")[0]) - 20)
    detail.pack(fill="x", padx=12)
    live = tk.Label(root, text="", fg="#8fd0ff", bg="#101418", font=("DejaVu Sans Mono", int(a.font * 0.75)), anchor="w")
    live.pack(fill="x", padx=12, pady=(6, 0))
    tk.Label(root, text=a.footer, fg="#6c7680", bg="#101418", font=("DejaVu Sans", int(a.font * 0.55)),
             anchor="w").pack(side="bottom", fill="x", padx=12, pady=(0, 6))
    pending = []

    def setter(h, d, colour):
        pending.append((h, d, colour))  # applied on the Tk thread

    ui["set"] = setter
    threading.Thread(target=rclpy.spin, args=(node,), daemon=True).start()

    def pump():
        while pending:
            h, d, colour = pending.pop(0)
            head.configure(text=h, fg=colour)
            detail.configure(text=d)
        live.configure(text=cap.live)
        root.after(100, pump)

    pump()
    try:
        root.mainloop()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
