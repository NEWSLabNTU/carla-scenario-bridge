<?xml version="1.0" encoding="UTF-8"?>
<!--
  The simulation side, long-lived, for any simulator (roadmap 046): the scenario bridge and the
  agent relay vehicles attach to, in the ROS domain scenarios will run in. The bridge drives
  the world server at world_endpoint; a simulator's own launch starts that server beside this
  (carla_simulation.launch.xml) or expects it running (isaac_simulation.launch.xml, with
  `just isaac-world`). Then run any number of scenarios (scenario.launch.xml) and start vehicle
  sides in any domain.

    play_launch launch FLAGS csb_launch simulation.launch.xml world_endpoint:=tcp://127.0.0.1:5591 \
        [config_file:=...] [ssv2_port:=5555] [agent_port:=5560] [weather:=ClearNoon] [gap_trace_dir:=DIR]

    FLAGS are the play_launch option web-addr 127.0.0.1:<CSB_WEB_PORT+4> (8084)
    (each with a double-hyphen prefix, which an XML comment cannot contain);
    docs/user-guide.md section 4 says why.
-->
<launch>
  <arg name="world_endpoint" default="" description="the world server's ZMQ endpoint; empty keeps the config file's"/>
  <arg name="world_render" default=""/>
  <arg name="world_request_timeout_seconds" default=""/>
  <arg name="world_load_timeout_seconds" default=""/>
  <arg name="config_file" default="$(find-pkg-share carla_scenario_bridge)/config/bridge_config.yaml"/>
  <arg name="ssv2_port" default=""/>
  <arg name="entity" default="ego" description="the scenario entity the relay serves"/>
  <arg name="agent_port" default="5560" description="TCP port vehicle agents connect to"/>
  <arg name="npc_motion" default=""
       description="kinematic | tracked: how SSv2-driven NPCs move (roadmaps 023, 044); empty keeps the config file's (default tracked)"/>
  <arg name="weather" default=""
       description="weather preset (ClearNoon, CloudySunset, ...) for a world server with weather, kept across map loads; empty keeps the config file's"/>
  <arg name="gap_trace_dir" default=""
       description="where each episode's gap trace (roadmap 024) is written for gap_oracle; empty keeps the config file's (default: no trace)"/>
  <arg name="contact_report_dir" default=""
       description="where each ego run's contacts are written for physical_verdict (roadmap 021); 'off' disables; empty keeps the config file's (default ~/.ros/csb/contacts)"/>

  <include file="$(find-pkg-share carla_scenario_bridge)/launch/bridge.launch.xml">
    <arg name="world_endpoint" value="$(var world_endpoint)"/>
    <arg name="world_render" value="$(var world_render)"/>
    <arg name="world_request_timeout_seconds" value="$(var world_request_timeout_seconds)"/>
    <arg name="world_load_timeout_seconds" value="$(var world_load_timeout_seconds)"/>
    <arg name="config_file" value="$(var config_file)"/>
    <arg name="ssv2_port" value="$(var ssv2_port)"/>
    <arg name="weather" value="$(var weather)"/>
    <arg name="npc_motion" value="$(var npc_motion)"/>
    <arg name="contact_report_dir" value="$(var contact_report_dir)"/>
    <arg name="gap_trace_dir" value="$(var gap_trace_dir)"/>
    <!-- Entities with controller `agent` are driven through this same relay. -->
    <arg name="agent_relay" value="tcp://localhost:$(var agent_port)"/>
  </include>
  <include file="$(find-pkg-share scenario_agent_relay)/launch/relay.launch.xml">
    <arg name="entity" value="$(var entity)"/>
    <arg name="agent_port" value="$(var agent_port)"/>
  </include>
</launch>
