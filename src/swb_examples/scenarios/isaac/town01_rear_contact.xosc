<?xml version="1.0"?>
<!--
	Isaac Sim, before its vehicle bridge (roadmap 037): basic/town01_rear_contact.xosc with an
	ego no Autoware drives. Run it with managed_ego:=false (see swb_examples/README.md,
	"Isaac Sim"): the ego stands where it spawns, Isaac reads its pose back and SSv2 adopts
	it, and a blind NPC, puppeteered by SSv2 at 8 m/s, runs into its back and brakes. On Isaac
	every body is kinematic, so nothing is shoved: the contact lasts until the exit, 1 s after
	SSv2 saw it, and Isaac reports it on every frame in between.
	Success = SSv2 saw the collision; failure = 120 s without. The ego has no routing action:
	an unmanaged ego has no autonomy to route.
	The contact is the point, so csbExpectedContacts declares it.
-->
<OpenSCENARIO>
	<FileHeader author="scenario-world-bridge" date="2026-10-05T00:00:00+00:00" description="Town01 rear contact by a blind NPC into a standing, unmanaged ego, for Isaac Sim (roadmap 037)" revMajor="1" revMinor="2" />
	<ParameterDeclarations>
		<ParameterDeclaration name="csbExpectedContacts" parameterType="string" value="npc_rear" />
	</ParameterDeclarations>
	<CatalogLocations />
	<RoadNetwork>
		<LogicFile filepath="$(env CARLA_MAPS)/Town01" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
				<BoundingBox>
					<Center x="1.532" y="0.0" z="0.744" />
					<Dimensions width="2.163" height="1.488" length="4.792" />
				</BoundingBox>
				<Performance maxSpeed="50" maxAcceleration="15.0" maxDeceleration="15.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
					<RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
				</Axles>
				<Properties />
			</Vehicle>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
		<ScenarioObject name="npc_rear">
			<Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
				<BoundingBox>
					<Center x="1.532" y="0.0" z="0.744" />
					<Dimensions width="2.163" height="1.488" length="4.792" />
				</BoundingBox>
				<Performance maxSpeed="20" maxAcceleration="5.0" maxDeceleration="8.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.8" positionX="3.1" positionZ="0.3" />
					<RearAxle maxSteering="0.0" wheelDiameter="0.6" trackWidth="1.8" positionX="0.0" positionZ="0.3" />
				</Axles>
				<Properties />
			</Vehicle>
			<ObjectController>
				<Controller name="">
					<Properties>
						<!-- Blind: the NPC does not slow for what is ahead, so it reaches the ego. -->
						<Property name="isBlind" value="true" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init>
			<Actions>
				<Private entityRef="ego">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="190.8" y="-130.1" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
				</Private>
				<Private entityRef="npc_rear">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="215.8" y="-130.1" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
				</Private>
			</Actions>
		</Init>
		<Story name="town01_rear_contact_isaac">
			<Act name="contact_act">
				<ManeuverGroup maximumExecutionCount="1" name="npc_group">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="npc_rear" />
					</Actors>
					<Maneuver name="npc_maneuver">
						<Event name="npc_go" priority="parallel">
							<Action name="npc_speed">
								<PrivateAction>
									<LongitudinalAction>
										<SpeedAction>
											<SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" />
											<SpeedActionTarget>
												<AbsoluteTargetSpeed value="8.0" />
											</SpeedActionTarget>
										</SpeedAction>
									</LongitudinalAction>
								</PrivateAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="npc_start" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="2" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<!-- Once it has hit the ego the NPC brakes, as a driver would. Without this a
						     blind NPC keeps driving at 8 m/s through the ego's pose for the 3 s the
						     run lasts after the contact, and in CARLA, where bodies push, that
						     shoves the ego down the road (into a pole, twice in 2026-10-12 runs). -->
						<Event name="npc_brake" priority="parallel">
							<Action name="npc_stop">
								<PrivateAction>
									<LongitudinalAction>
										<SpeedAction>
											<SpeedActionDynamics dynamicsShape="linear" value="8.0" dynamicsDimension="rate" />
											<SpeedActionTarget>
												<AbsoluteTargetSpeed value="0.0" />
											</SpeedActionTarget>
										</SpeedAction>
									</LongitudinalAction>
								</PrivateAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="npc_hit_ego" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="npc_rear" />
											</TriggeringEntities>
											<EntityCondition>
												<CollisionCondition>
													<EntityRef entityRef="ego" />
												</CollisionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<ManeuverGroup maximumExecutionCount="1" name="end_group">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="ego" />
					</Actors>
					<Maneuver name="end_conditions">
						<Event name="collision_seen" priority="parallel">
							<Action name="exit_success">
								<UserDefinedAction>
									<CustomCommandAction type="exitSuccess" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="ssv2_collision" delay="1.0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="npc_rear" />
											</TriggeringEntities>
											<EntityCondition>
												<CollisionCondition>
													<EntityRef entityRef="ego" />
												</CollisionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure">
								<UserDefinedAction>
									<CustomCommandAction type="exitFailure" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="timeout_condition" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="120" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
