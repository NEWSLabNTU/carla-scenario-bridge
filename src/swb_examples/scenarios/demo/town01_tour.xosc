							<SpeedActionTarget><AbsoluteTargetSpeed value="1.3" /></SpeedActionTarget>
						</SpeedAction></LongitudinalAction></PrivateAction></Action><Action name="p_close_1_path"><PrivateAction><RoutingAction><FollowTrajectoryAction initialDistanceOffset="0">
							<TimeReference><Timing domainAbsoluteRelative="relative" offset="0" scale="1" /></TimeReference>
