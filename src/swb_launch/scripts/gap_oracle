#!/usr/bin/env python3
"""Find the frames where SSv2's world and CARLA's disagree (roadmap 024, the gap oracle).

    ros2 run swb_launch gap_oracle <trace.jsonl> [--junit result.junit.xml]
        [--out findings.json] [--pos M] [--yaw-deg DEG] [--z M] [--sustain N]
        [--contact-window N]

Reads one gap trace the bridge wrote (`gap_trace_dir`; format in
docs/design/gap-campaign.md, appendix) and checks the campaign's differential contracts
C1-C4 as G1-G4. Every frame is judged in two geometries: SSv2's (declared boxes at SSv2's
poses, the 2D check `CollisionCondition` makes, with its height gate) and CARLA's
(blueprint boxes at CARLA's transforms), plus CARLA's recorded contacts.

  G1  overlap disagreement: an ego-entity pair overlaps in one geometry and not the other.
      One finding per interval of consecutive frames: max penetration in the overlapping
      geometry, min gap in the other, and the extreme margin difference d_ssv2 - d_carla
      (negative: SSv2's boxes are the closer). NPC-NPC pairs: the same, priority "low".
      CARLA's side counts the frame of a recorded contact of the pair and the N after it
      (--contact-window) as overlap: the contact is CARLA's own word that the bodies touch
      (its blueprint box is not its collision mesh), and the collision sensor reports a hit,
      not every frame the bodies then rest against each other a few mm apart. A frame whose
      |d_ssv2 - d_carla| is within the ego's one-tick lag (its SSv2 pose is read back
      before the tick: the in-plane distance between that pose, offset applied, and CARLA's)
      plus --touch (0.05 m) is timing, not geometry, and is info (`lag_band`): the edges
      of a contact both worlds saw land there.
  G2  a CARLA contact with no SSv2 overlap of the same pair within +-N frames
      (--contact-window, 2); every static-world hit and every hit on a CARLA actor that is
      no SSv2 entity. Contacts of one pair close in time are one finding. Contacts a tracked
      NPC's own sensor saw (the trace's `subject`, roadmap 032): the same rules, priority
      "low" as NPC-NPC G1 pairs are -- an NPC-vs-static hit, an NPC pair SSv2 never saw
      touch (both NPCs' reports one finding); an NPC's contact with the ego is left to the
      ego's sensor, never counted twice. Only the ego's G2 enters G4.
  G3  pose divergence of a non-ego entity: CARLA's transform against SSv2's pose moved by
      the entity's OriginOffset, beyond --pos (0.2 m) or --yaw-deg (2) in plane or --z
      (0.5 m) for --sustain (3) consecutive frames. z compares box bottoms (where each world
      puts the body on the ground), so a walker, whose CARLA origin is its body centre, is
      judged by its feet. Not the ego: its SSv2 pose is read back before the tick and
      trails CARLA's by one tick of motion by protocol (doc appendix, "Pairing"). Frames
      flagged `spawn`, `contact_hold` or `kinematic` (a blocked NPC handed to kinematic,
      032: at SSv2's pose by construction), and frames with no CARLA state, are info; so is
      the recovery right after a hold (`hold_recovery`: the run of frames adjacent to a
      `contact_hold` run whose error only shrinks -- below the snap distance the tracker
      closes it over a few frames). Nor an entity SSv2 reads back from CARLA like the
      ego (`read_back`: a simulator-driven NPC, controller simulator_autopilot), found
      from the trace itself: while it moves, its SSv2 pose is CARLA's previous one. Its
      one-tick lag widens G1's band as the ego's does.
  G4  verdict class, G1-G3 joined with the JUnit result (SSv2's testcases; run_suite's
      `carla_contact` testcase is not SSv2's verdict and is skipped):
        PASS+contact                          SSv2 passed, the ego hit something SSv2 could
                                              not see (a G2 finding)
        PASS+overlap-only-in-CARLA            SSv2 passed, CARLA's bodies overlapped (G1)
        FAIL(collision)+no-contact            SSv2 failed on a collision, CARLA had no contact
        FAIL(collision)+overlap-only-in-SSv2  ... and SSv2's boxes overlapped where CARLA's
                                              did not (G1)
        agree                                 none of the above
        unknown                               no --junit, or no verdict in it
      A failure is a collision failure when its message names one ("colliding", "collision").

Output: one summary line on stdout; with --out, findings.json (schema below, `SCHEMA`):
every finding as {check, priority, entities, frames [first, last], count, numbers, ...},
info notes the same shape, the G4 class, the run's gap signature (contract x entity class x
geometry, e.g. "C1:vehicle:ssv2") and the ego pairs' margins (min d_ssv2, min d_carla,
min and max d_ssv2 - d_carla), which the generator (025) takes as feedback.

Exit status: 0 whatever was found (findings are data, not failures); 2 when the trace
cannot be read. A trace cut short (no end record) is judged and marked `complete: false`.
"""

import argparse
import json
import math
import re
import sys
import xml.etree.ElementTree as ET
from dataclasses import asdict, dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

import gap_geometry as gg  # noqa: E402
import gap_trace as gt  # noqa: E402

SCHEMA = 1
PHYSICAL_TESTCASE = "carla_contact"
COLLISION_RE = re.compile(r"collid|collision", re.IGNORECASE)

# G4 classes in the order the phase doc lists them, and the one reported when several hold
# (the more specific explanation first).
G4_CLASSES = (
    "PASS+contact",
    "PASS+overlap-only-in-CARLA",
    "FAIL(collision)+no-contact",
    "FAIL(collision)+overlap-only-in-SSv2",
)
G4_PRIMARY = (
    "PASS+contact",
    "PASS+overlap-only-in-CARLA",
    "FAIL(collision)+overlap-only-in-SSv2",
    "FAIL(collision)+no-contact",
)


@dataclass(frozen=True)
class Tolerances:
    pos: float = 0.2  # m, in plane (C3)
    yaw_deg: float = 2.0  # degrees (C3)
    z: float = 0.5  # m (C3)
    sustain: int = 3  # frames a G3 divergence must last
    contact_window: int = 2  # frames either side of a contact searched for SSv2 overlap
    touch: float = 0.05  # m, G1: margin difference a resting contact or rounding explains


def _r(x):
    return None if x is None else round(x, 6)


# --- JUnit --------------------------------------------------------------------------------


def read_junit(path):
    """(verdict, message): SSv2's verdict in a result.junit.xml.

    verdict is "pass", "fail_collision", "fail_other" or "error" (an error testcase, no
    testcase, or an unreadable file); message is the first failure's or error's text.
    """
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError) as e:
        return "error", f"unreadable {path}: {e}"
    failures, errors, cases = [], [], 0
    for case in root.iter("testcase"):
        if case.get("name") == PHYSICAL_TESTCASE:
            continue
        cases += 1
        for kind, sink in (("failure", failures), ("error", errors)):
            for node in case.findall(kind):
                text = " ".join(t for t in (node.get("message"), node.text) if t)
                sink.append(" ".join(text.split()))
    collisions = [m for m in failures if COLLISION_RE.search(m)]
    if collisions:
        return "fail_collision", collisions[0]
    if failures:
        return "fail_other", failures[0]
    if errors:
        return "error", errors[0]
    if cases == 0:
        return "error", f"{path} has no SSv2 testcase"
    return "pass", ""


# --- geometry per frame -------------------------------------------------------------------


# Read-back detection (G3): a frame counts when CARLA moved at least READ_BACK_STEP since
# the previous frame; it matches when SSv2's pose (offset applied) is within
# READ_BACK_MATCH of the step of CARLA's previous pose and further from CARLA's current one.
READ_BACK_STEP = 0.05  # m per frame (1 m/s at 20 Hz)
READ_BACK_MATCH = 0.25  # fraction of the step
READ_BACK_MIN_FRAMES = 10
READ_BACK_FRACTION = 0.9


def read_back_entities(trace, kinds):
    """{name: (match fraction, moving frames, first frame, last frame)} of the non-ego
    entities whose SSv2 pose is CARLA's pose of the frame before: the bridge reports their
    pose back to SSv2 (read before the tick, as the ego's) instead of applying SSv2's."""
    out = {}
    for name, h in trace.entities.items():
        if kinds.get(name) == "ego":
            continue
        o = h.origin_offset
        prev = None
        moving, matched, first, last = 0, 0, None, None
        for f in trace.frames:
            s = f.entities.get(name)
            if s is None or s.carla is None:
                prev = None
                continue
            if prev is not None:
                step = math.hypot(s.carla.x - prev.x, s.carla.y - prev.y)
                if step >= READ_BACK_STEP:
                    p = s.ssv2
                    e = gg.actor_pose_from_entity(gg.Pose2D(p.x, p.y, p.yaw), o.x, o.y, o.yaw)
                    to_prev = math.hypot(e.x - prev.x, e.y - prev.y)
                    to_now = math.hypot(e.x - s.carla.x, e.y - s.carla.y)
                    moving += 1
                    if to_prev <= READ_BACK_MATCH * step and to_prev < to_now:
                        matched += 1
                    first = f.frame if first is None else first
                    last = f.frame
            prev = s.carla
        if moving >= READ_BACK_MIN_FRAMES and matched >= READ_BACK_FRACTION * moving:
            out[name] = (matched / moving, moving, first, last)
    return out


@dataclass(frozen=True)
class _Body:
    box: object  # gg.OrientedBox
    z: tuple  # (z, centre z, height) for gg.z_separated
    reach: float  # centre plus half diagonal, for pruning far pairs


def _body(box, z):
    return _Body(box, z, math.hypot(box.half_length, box.half_width))


def ssv2_body(header, s):
    p = s.ssv2
    box = gg.ssv2_box(gg.Pose2D(p.x, p.y, p.yaw), header.declared.center,
                      header.declared.dimensions)
    return _body(box, (p.z, header.declared.center[2], header.declared.dimensions[2]))


def carla_body(header, s):
    bp = header.blueprint_box
    if s.carla is None or bp is None:
        return None
    p = s.carla
    box = gg.carla_box(gg.Pose2D(p.x, p.y, p.yaw), bp.location, bp.extent)
    return _body(box, (p.z, bp.location[2], 2.0 * bp.extent[2]))


def _far(a, b):
    return math.hypot(a.box.cx - b.box.cx, a.box.cy - b.box.cy) > a.reach + b.reach + 1e-6


def margin(a, b):
    """(signed distance or None, overlap): None when the height gate separates them, as
    SSv2 then makes no 2D check."""
    if gg.z_separated(*a.z, *b.z):
        return None, False
    d = gg.signed_distance(a.box, b.box)
    return d, d <= gg.TOUCH_TOLERANCE


# --- the oracle ---------------------------------------------------------------------------


def _headers_by_frame(trace):
    """Yield (frame, {name: header in effect}) in frame order; a respawn replaces."""
    pending = sorted(trace.headers, key=lambda h: h.frame)
    current = {}
    i = 0
    for f in trace.frames:
        while i < len(pending) and pending[i].frame <= f.frame:
            current[pending[i].name] = pending[i]
            i += 1
        yield f, current


def _intervals(rows, key):
    """Split (index, ...) rows into runs of consecutive trace indices with the same key."""
    runs = []
    for row in rows:
        k = key(row)
        if k is None:
            continue
        if runs and runs[-1][0] == k and runs[-1][1][-1][0] == row[0] - 1:
            runs[-1][1].append(row)
        else:
            runs.append((k, [row]))
    return runs


def _finding(check, entities, rows_frames, count, numbers, **extra):
    f = {"check": check, **extra, "entities": entities,
         "frames": [rows_frames[0], rows_frames[-1]], "count": count, "numbers": numbers}
    return f


def analyze(trace, tol=None, junit=None):
    """findings.json as a dict. `junit` is read_junit's (verdict, message), or None."""
    tol = tol or Tolerances()
    order = {}
    for h in trace.headers:
        order.setdefault(h.name, len(order))
    kinds = {h.name: h.kind for h in trace.headers}
    egos = [n for n in order if kinds[n] == "ego"]
    frames = trace.frames

    pairs = {}  # (a, b) -> [(index, frame, sim_time, d_s, o_s, d_c, o_c)]
    ssv2_overlap = {}  # frozenset({a, b}) -> set of frames
    g3_rows = {}  # name -> [(index, frame, sim_time, status, xy, yaw, z)]
    margins = {}
    ego_by_id = {h.actor_id: h.name for h in trace.headers if h.kind == "ego"}
    contact_frames = {}  # frozenset({ego, other}) -> frames with a recorded contact
    for c in trace.contacts:
        other = c.name if c.name in kinds else None
        # The sensor's side: the ego's, or a tracked NPC's own (032 step 5).
        side = c.subject if c.subject in kinds else (
            ego_by_id.get(c.ego_id) or (egos[0] if egos else None))
        # An NPC's report of the ego is the ego sensor's to make: ego pairs judge as before.
        if not c.ego_side and other in egos:
            continue
        if other is not None and side is not None and other != side:
            contact_frames.setdefault(frozenset((side, other)), set()).add(c.frame)
    w = tol.contact_window
    read_back = read_back_entities(trace, kinds)

    def track(key, value, where):
        if value is not None and (key not in margins or value < margins[key][0]):
            margins[key] = (value, where)

    def track_max(key, value, where):
        if value is not None and (key not in margins or value > margins[key][0]):
            margins[key] = (value, where)

    for idx, (f, headers) in enumerate(_headers_by_frame(trace)):
        names = sorted(f.entities, key=lambda n: order.get(n, len(order)))
        bodies = {}
        lag = {}
        for n in names:
            h = headers.get(n) or trace.entities[n]
            s = f.entities[n]
            bodies[n] = (ssv2_body(h, s), carla_body(h, s))
            g3 = _g3(h, s, tol)
            if kinds.get(n) != "ego" and n not in read_back:
                g3_rows.setdefault(n, []).append((idx, f.frame, f.sim_time, *g3))
            else:
                lag[n] = g3[1] or 0.0  # one tick of motion, by protocol
        for i, a in enumerate(names):
            for b in names[i + 1:]:
                is_ego = a in egos or b in egos
                sa, ca = bodies[a]
                sb, cb = bodies[b]
                if not is_ego and _far(sa, sb) and (ca is None or cb is None or _far(ca, cb)):
                    continue
                d_s, o_s = margin(sa, sb)
                d_c, o_c = (None, None) if ca is None or cb is None else margin(ca, cb)
                touched = contact_frames.get(frozenset((a, b)), ())
                if o_c is False and any(f.frame - k in touched for k in range(w + 1)):
                    o_c = True
                band = max(lag.get(a, 0.0), lag.get(b, 0.0)) + tol.touch
                pairs.setdefault((a, b), []).append(
                    (idx, f.frame, f.sim_time, d_s, o_s, d_c, o_c, band))
                if o_s:
                    ssv2_overlap.setdefault(frozenset((a, b)), set()).add(f.frame)
                if is_ego:
                    where = {"entities": [a, b], "frame": f.frame}
                    track("min_d_ssv2", d_s, where)
                    track("min_d_carla", d_c, where)
                    if d_s is not None and d_c is not None:
                        track("min_margin_difference", d_s - d_c, where)
                        track_max("max_margin_difference", d_s - d_c, where)

    findings, info = [], []
    g1, g1_info = _g1(pairs, egos, kinds)
    findings += g1
    info += g1_info
    findings += _g2(trace, egos, kinds, order, ssv2_overlap, tol)
    g3, g3_info = _g3_findings(g3_rows, kinds, tol)
    findings += g3
    info += g3_info
    for n, (fraction, moving, first, last) in read_back.items():
        info.append(_finding("G3", [n], [first, last], moving,
                             {"match_fraction": _r(fraction)}, kind="read_back"))
    info.sort(key=lambda f: (f["check"], f["frames"][0]))

    g4 = _g4(findings, trace, junit)
    signature = set()
    for f in findings:
        if f["check"] == "G1":
            cls = f["other_kind"] if f["priority"] == "high" else "npc_pair"
            signature.add(f"C1:{cls}:{f['geometry']}")
        elif f["check"] == "G2":
            kind = f["numbers"]["other_kind"]
            if f["priority"] != "high":
                kind = "npc_static" if kind == "static" else (
                    "npc_unknown" if kind == "unknown" else "npc_pair")
            signature.add(f"C2:{kind}:carla")
        elif f["check"] == "G3":
            signature.add(f"C3:{kinds[f['entities'][0]]}:pose")
    if g4["class"] not in ("agree", "unknown"):
        signature.add(f"C4:{g4['class']}")

    counts = {
        "G1": sum(f["check"] == "G1" for f in findings),
        "G1_ego": sum(f["check"] == "G1" and f["priority"] == "high" for f in findings),
        "G1_npc": sum(f["check"] == "G1" and f["priority"] == "low" for f in findings),
        "G2": sum(f["check"] == "G2" for f in findings),
        "G2_ego": sum(f["check"] == "G2" and f["priority"] == "high" for f in findings),
        "G2_npc": sum(f["check"] == "G2" and f["priority"] == "low" for f in findings),
        "G3": sum(f["check"] == "G3" for f in findings),
        "info": len(info),
    }
    end = trace.end
    return {
        "schema": SCHEMA,
        "episode": trace.episode.episode,
        "start_unix": trace.episode.start_unix,
        "npc_motion": trace.episode.npc_motion,
        "complete": bool(end is not None and end.complete),
        "frames": len(frames),
        "first_frame": frames[0].frame if frames else None,
        "last_frame": frames[-1].frame if frames else None,
        "dropped_frames": end.dropped_frames if end is not None else None,
        "contacts": len(trace.contacts),
        "entities": {h.name: {"kind": h.kind, "blueprint": h.blueprint,
                              "declared": list(h.declared.dimensions),
                              "blueprint_size": None if h.blueprint_box is None else
                              [_r(2.0 * e) for e in h.blueprint_box.extent]}
                     for h in trace.entities.values()},
        "tolerances": asdict(tol),
        "verdict": None if junit is None else junit[0],
        "verdict_message": None if junit is None else junit[1],
        "g4": g4,
        "counts": counts,
        "signature": sorted(signature),
        "margins": {k: _r(v[0]) for k, v in sorted(margins.items())}
        | {f"{k}_at": v[1] for k, v in sorted(margins.items())},
        "findings": findings,
        "info": info,
    }


def _g1(pairs, egos, kinds):
    out, info = [], []
    for (a, b), rows in pairs.items():
        is_ego = a in egos or b in egos
        other = b if a in egos else a

        def side(row):
            _, _, _, d_s, o_s, d_c, o_c, band = row
            if o_c is None or o_s == o_c:
                return None
            geometry = "ssv2" if o_s else "carla"
            if d_s is not None and d_c is not None and abs(d_s - d_c) <= band:
                return ("lag_band", geometry)
            return geometry

        for key, run in _intervals(rows, side):
            geometry = key[1] if isinstance(key, tuple) else key
            # The overlapping geometry's margin (a contact-only CARLA overlap has a box gap).
            d_in = [r[3] if geometry == "ssv2" else r[5] for r in run]
            d_out = [r[5] if geometry == "ssv2" else r[3] for r in run]
            diffs = [r[3] - r[5] for r in run if r[3] is not None and r[5] is not None]
            # Penetration over the frames that have a margin. None when none does: an
            # overlap made only by the contact rule while the height gate separates the
            # boxes (an airborne ego, 032 N3).
            depths = [-d if d is not None else -math.inf for d in d_in]
            pen = max(depths) if any(d is not None for d in d_in) else None
            deepest = run[depths.index(pen)][1] if pen is not None else None
            gaps = [d for d in d_out if d is not None]
            diff = (min(diffs) if geometry == "ssv2" else max(diffs)) if diffs else None
            numbers = {"max_penetration": _r(pen), "deepest_frame": deepest,
                       "min_gap": _r(min(gaps)) if gaps else None,
                       "margin_difference": _r(diff),
                       "max_band": _r(max(r[7] for r in run)),
                       "sim_time": [_r(run[0][2]), _r(run[-1][2])]}
            frames_ = [r[1] for r in run]
            if isinstance(key, tuple):
                info.append(_finding("G1", [a, b], frames_, len(run), numbers, kind=key[0],
                                     geometry=geometry))
                continue
            out.append(_finding(
                "G1", [a, b], frames_, len(run), numbers,
                priority="high" if is_ego else "low", geometry=geometry,
                other_kind=kinds.get(other) if is_ego else None))
    out.sort(key=lambda f: (f["priority"] != "high", f["frames"][0]))
    info.sort(key=lambda f: f["frames"][0])
    return out, info


def _g2(trace, egos, kinds, order, ssv2_overlap, tol):
    ego_by_id, name_by_id = {}, {}
    for h in trace.headers:
        name_by_id[h.actor_id] = h.name
        if h.kind == "ego":
            ego_by_id[h.actor_id] = h.name
    unseen = {}  # (side, label) -> [contact]; a pair of two NPCs keyed in header order
    for c in sorted(trace.contacts, key=lambda c: (c.frame, c.carla_frame)):
        ego = ego_by_id.get(c.ego_id) or (egos[0] if egos else "ego")
        # A tracked NPC's own sensor (032 step 5). Its contacts with the ego are the ego
        # sensor's to report -- the same contact, seen twice -- so they are not counted here.
        side = c.subject if not c.ego_side else ego
        if not c.ego_side and (c.other_kind == "ego" or c.name in egos):
            continue
        if c.other_kind == "static":
            label = "static"
        else:
            other = c.name or name_by_id.get(c.other_id)
            if other is None or other not in kinds or c.other_kind == "unknown":
                label = f"unknown:{c.other_id}"
            else:
                label = other
                seen = ssv2_overlap.get(frozenset((side, other)), set())
                w = tol.contact_window
                if any(c.frame + k in seen for k in range(-w, w + 1)):
                    continue
                if not c.ego_side:
                    # Both NPCs' sensors report one contact: one pair, one finding.
                    side, label = sorted((side, label), key=lambda n: order.get(n, len(order)))
        unseen.setdefault((side, label), []).append(c)
    out = []
    for (side, label), cs in unseen.items():
        groups = []
        for c in cs:
            if groups and c.frame - groups[-1][-1].frame <= max(1, 2 * tol.contact_window):
                groups[-1].append(c)
            else:
                groups.append([c])
        for g in groups:
            out.append(_finding(
                "G2", [side, label], [c.frame for c in g], len(g),
                {"max_impulse": _r(max(c.impulse for c in g)), "other_kind": g[0].other_kind,
                 "other_type": g[0].other_type, "other_id": g[0].other_id,
                 "carla_frames": [g[0].carla_frame, g[-1].carla_frame],
                 "sim_time": [_r(g[0].sim_time), _r(g[-1].sim_time)]},
                priority="high" if g[0].ego_side else "low"))
    out.sort(key=lambda f: (f["priority"] != "high", f["frames"][0]))
    return out


def _g3(header, s, tol):
    """(status, xy, yaw, z) of one entity state: status is "missed", "spawn",
    "contact_hold", "kinematic", "beyond" or "ok"."""
    if s.carla is None:
        return "missed", None, None, None
    o = header.origin_offset
    p = s.ssv2
    expected = gg.actor_pose_from_entity(gg.Pose2D(p.x, p.y, p.yaw), o.x, o.y, o.yaw)
    xy, yaw = gg.pose_error(expected, gg.Pose2D(s.carla.x, s.carla.y, s.carla.yaw))
    bp = header.blueprint_box
    if bp is not None:
        ssv2_bottom = p.z + header.declared.center[2] - header.declared.dimensions[2] / 2.0
        carla_bottom = s.carla.z + bp.location[2] - bp.extent[2]
        dz = abs(carla_bottom - ssv2_bottom)
    else:
        dz = abs(s.carla.z - p.z)
    beyond = xy > tol.pos or yaw > math.radians(tol.yaw_deg) or dz > tol.z
    if not beyond:
        return "ok", xy, yaw, dz
    if s.spawn:
        return "spawn", xy, yaw, dz
    if s.contact_hold:
        return "contact_hold", xy, yaw, dz
    if s.kinematic:
        return "kinematic", xy, yaw, dz
    return "beyond", xy, yaw, dz


def _g3_numbers(run, tol):
    xy = max(r[4] for r in run)
    yaw = math.degrees(max(r[5] for r in run))
    z = max(r[6] for r in run)
    axes = [a for a, v, lim in (("xy", xy, tol.pos), ("yaw", yaw, tol.yaw_deg), ("z", z, tol.z))
            if v > lim]
    return {"max_xy": _r(xy), "max_yaw_deg": _r(yaw), "max_z": _r(z), "beyond": axes,
            "sim_time": [_r(run[0][2]), _r(run[-1][2])]}


def _g3_findings(rows_by_name, kinds, tol):
    findings, info = [], []
    for name, rows in rows_by_name.items():
        previous = None
        for status, run in _intervals(rows, lambda r: None if r[3] == "ok" else r[3]):
            frames_ = [r[1] for r in run]
            after_hold = (previous is not None and previous[0] == "contact_hold"
                          and previous[1][-1][0] + 1 == run[0][0])
            previous = (status, run)
            if status == "beyond" and after_hold and all(
                    b[4] <= a[4] + 1e-9 for a, b in zip(run, run[1:])):
                info.append(_finding("G3", [name], frames_, len(run), _g3_numbers(run, tol),
                                     kind="hold_recovery"))
            elif status == "missed":
                info.append(_finding("G3", [name], frames_, len(run), {}, kind="missed"))
            elif status in ("spawn", "contact_hold", "kinematic"):
                info.append(_finding("G3", [name], frames_, len(run), _g3_numbers(run, tol),
                                     kind=status))
            elif len(run) >= tol.sustain:
                findings.append(_finding("G3", [name], frames_, len(run),
                                         _g3_numbers(run, tol), priority="high"))
    findings.sort(key=lambda f: f["frames"][0])
    info.sort(key=lambda f: f["frames"][0])
    return findings, info


def _g4(findings, trace, junit):
    if junit is None:
        return {"class": "unknown", "classes": [], "reason": "no --junit"}
    verdict = junit[0]
    ego_g1 = [f for f in findings if f["check"] == "G1" and f["priority"] == "high"]
    ssv2_only = any(f["geometry"] == "ssv2" for f in ego_g1)
    carla_only = any(f["geometry"] == "carla" for f in ego_g1)
    # The ego's contacts only: an NPC's own (032 step 5) say nothing about the ego's verdict.
    g2 = any(f["check"] == "G2" and f["priority"] == "high" for f in findings)
    holds = set()
    if verdict == "pass":
        if g2:
            holds.add("PASS+contact")
        if carla_only:
            holds.add("PASS+overlap-only-in-CARLA")
    elif verdict == "fail_collision":
        if not any(c.ego_side for c in trace.contacts):
            holds.add("FAIL(collision)+no-contact")
        if ssv2_only:
            holds.add("FAIL(collision)+overlap-only-in-SSv2")
    elif verdict == "error":
        return {"class": "unknown", "classes": [], "reason": "no SSv2 verdict in the JUnit"}
    classes = [c for c in G4_CLASSES if c in holds]
    primary = next((c for c in G4_PRIMARY if c in holds), "agree")
    return {"class": primary, "classes": classes}


# --- output -------------------------------------------------------------------------------


def summary_line(name, result):
    c = result["counts"]
    g4 = result["g4"]["class"]
    verdict = result["verdict"] or "no junit"
    diff = result["margins"].get("min_margin_difference")
    diff_text = "n/a" if diff is None else f"{diff:+.2f} m"
    sig = ",".join(result["signature"]) or "-"
    flags = "" if result["complete"] else " INCOMPLETE"
    return (f"{name}: G1 {c['G1']} ({c['G1_ego']} ego, {c['G1_npc']} npc) "
            f"G2 {c['G2']} ({c['G2_ego']} ego, {c['G2_npc']} npc) "
            f"G3 {c['G3']} info {c['info']} | G4 {g4} ({verdict}) | "
            f"min d_ssv2-d_carla {diff_text} | {result['frames']} frames, "
            f"{result['contacts']} contacts{flags} | signature {sig}")


def parse_args(argv):
    d = Tolerances()
    ap = argparse.ArgumentParser(
        prog="gap_oracle",
        description="Check a gap trace for SSv2-vs-CARLA disagreements (G1-G4, roadmap 024).")
    ap.add_argument("trace", help="the bridge's gap trace (.jsonl)")
    ap.add_argument("--junit", help="the scenario's result.junit.xml, for G4")
    ap.add_argument("--out", help="write findings.json here")
    ap.add_argument("--pos", type=float, default=d.pos,
                    help=f"G3 in-plane tolerance, m (default {d.pos})")
    ap.add_argument("--yaw-deg", type=float, default=d.yaw_deg,
                    help=f"G3 yaw tolerance, degrees (default {d.yaw_deg})")
    ap.add_argument("--z", type=float, default=d.z, help=f"G3 z tolerance, m (default {d.z})")
    ap.add_argument("--sustain", type=int, default=d.sustain,
                    help=f"G3: frames a divergence must last (default {d.sustain})")
    ap.add_argument("--contact-window", type=int, default=d.contact_window,
                    help=f"G2: frames either side of a contact searched for SSv2 overlap; "
                         f"G1: frames after a contact that count as touching in CARLA "
                         f"(default {d.contact_window})")
    ap.add_argument("--touch", type=float, default=d.touch,
                    help=f"G1: margin difference a resting contact explains, added to the "
                         f"ego's one-tick lag, m (default {d.touch})")
    return ap.parse_args(argv)


def main(argv=None):
    args = parse_args(sys.argv[1:] if argv is None else argv)
    tol = Tolerances(pos=args.pos, yaw_deg=args.yaw_deg, z=args.z, sustain=args.sustain,
                     contact_window=args.contact_window, touch=args.touch)
    try:
        trace = gt.load_trace(args.trace, require_end=False)
    except (gt.TraceError, OSError, UnicodeDecodeError) as e:
        print(f"gap_oracle: cannot read {args.trace}: {e}", file=sys.stderr)
        return 2
    junit = read_junit(args.junit) if args.junit else None
    result = analyze(trace, tol, junit)
    result["trace"] = str(Path(args.trace).resolve())
    result["junit"] = None if not args.junit else str(Path(args.junit).resolve())
    line = summary_line(Path(args.trace).name, result)
    result["summary"] = line
    if args.out:
        Path(args.out).write_text(json.dumps(result, indent=1) + "\n")
    print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
