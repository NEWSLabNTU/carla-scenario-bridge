	<Storyboard>
		<Init><Actions>
			<Private entityRef="ego">
				<PrivateAction><TeleportAction><Position><WorldPosition x="-2.03" y="-19.96" z="0.30" h="-1.5704" p="0" r="0" /></Position></TeleportAction></PrivateAction>
				<PrivateAction><RoutingAction><AssignRouteAction><Route name="route_c" closed="false"><Waypoint routeStrategy="shortest"><Position><WorldPosition x="213.62" y="-330.6" z="0.00" h="-0.0001" p="0" r="0" /></Position></Waypoint><Waypoint routeStrategy="shortest"><Position><WorldPosition x="396.3" y="-164.54" z="0.00" h="1.5710" p="0" r="0" /></Position></Waypoint><Waypoint routeStrategy="shortest"><Position><WorldPosition x="366.59" y="1.99" z="0.00" h="3.1411" p="0" r="0" /></Position></Waypoint><Waypoint routeStrategy="shortest"><Position><WorldPosition x="334.84" y="-94.03" z="0.00" h="-1.5714" p="0" r="0" /></Position></Waypoint><Waypoint routeStrategy="shortest"><Position><WorldPosition x="175.67" y="-195.15" z="0.00" h="3.1415" p="0" r="0" /></Position></Waypoint></Route></AssignRouteAction></RoutingAction></PrivateAction>
			</Private>
		</Actions></Init>
		<Story name="tour">
			<Act name="tour_act">
			<ManeuverGroup maximumExecutionCount="1" name="ego_group">
				<Actors selectTriggeringEntities="false"><EntityRef entityRef="ego" /></Actors>
				<Maneuver name="ego_group_m">
					<Event name="goal_reached" priority="parallel" maximumExecutionCount="1">
						<Action name="tour_goal_log"><UserDefinedAction><CustomCommandAction type="test(tour, goal)" /></UserDefinedAction></Action><Action name="exit_success"><UserDefinedAction><CustomCommandAction type="exitSuccess" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="at_goal" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><ReachPositionCondition tolerance="3.0"><Position><WorldPosition x="175.67" y="-195.15" z="0.00" h="3.1415" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="timeout" priority="parallel" maximumExecutionCount="1">
						<Action name="tour_timeout_log"><UserDefinedAction><CustomCommandAction type="test(tour, timeout)" /></UserDefinedAction></Action><Action name="exit_timeout"><UserDefinedAction><CustomCommandAction type="exitFailure" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="too_long" delay="0" conditionEdge="none"><ByValueCondition><SimulationTimeCondition value="600" rule="greaterThan" /></ByValueCondition></Condition></ConditionGroup></StartTrigger>
					</Event>
				</Maneuver>
			</ManeuverGroup>
			<ManeuverGroup maximumExecutionCount="1" name="i2_parked">
				<Actors selectTriggeringEntities="false"><EntityRef entityRef="i2_van" /><EntityRef entityRef="i2_parked" /></Actors>
				<Maneuver name="i2_parked_m">
					<Event name="i2_parked_start" priority="parallel" maximumExecutionCount="1">
						<Action name="add_i2_van"><GlobalAction><EntityAction entityRef="i2_van"><AddEntityAction><Position><WorldPosition x="-5.5" y="-196.8" z="0.00" h="-1.5702" p="0" r="0" /></Position></AddEntityAction></EntityAction></GlobalAction></Action><Action name="add_i2_parked"><GlobalAction><EntityAction entityRef="i2_parked"><AddEntityAction><Position><WorldPosition x="-5.6" y="-204.66" z="0.00" h="-1.5702" p="0" r="0" /></Position></AddEntityAction></EntityAction></GlobalAction></Action><Action name="i2_parked_start_live"><GlobalAction><ParameterAction parameterRef="i2_parked_phase"><SetAction value="1" /></ParameterAction></GlobalAction></Action><Action name="i2_parked_start_log"><UserDefinedAction><CustomCommandAction type="test(i2, start, i2_parked)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_trigger" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><ReachPositionCondition tolerance="3.0"><Position><WorldPosition x="-2.05" y="-49.96" z="0.00" h="-1.5712" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_parked_end" priority="parallel" maximumExecutionCount="1">
						<Action name="delete_i2_van"><GlobalAction><EntityAction entityRef="i2_van"><DeleteEntityAction /></EntityAction></GlobalAction></Action><Action name="delete_i2_parked"><GlobalAction><EntityAction entityRef="i2_parked"><DeleteEntityAction /></EntityAction></GlobalAction></Action><Action name="i2_parked_end_over"><GlobalAction><ParameterAction parameterRef="i2_parked_phase"><SetAction value="2" /></ParameterAction></GlobalAction></Action><Action name="i2_parked_end_log"><UserDefinedAction><CustomCommandAction type="test(i2, end, i2_parked)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_ego_past" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><ReachPositionCondition tolerance="3.0"><Position><WorldPosition x="-1.98" y="-240.96" z="0.00" h="-1.5704" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_end_live_0" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="i2_parked_phase" value="1" rule="equalTo" /></ByValueCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_parked_watchdog" priority="parallel" maximumExecutionCount="1">
						<Action name="delete_i2_van"><GlobalAction><EntityAction entityRef="i2_van"><DeleteEntityAction /></EntityAction></GlobalAction></Action><Action name="delete_i2_parked"><GlobalAction><EntityAction entityRef="i2_parked"><DeleteEntityAction /></EntityAction></GlobalAction></Action><Action name="i2_parked_watchdog_over"><GlobalAction><ParameterAction parameterRef="i2_parked_phase"><SetAction value="2" /></ParameterAction></GlobalAction></Action><Action name="i2_parked_watchdog_log"><UserDefinedAction><CustomCommandAction type="test(i2, watchdog, degraded, i2_parked)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_parked_watchdog_live" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="i2_parked_phase" value="1" rule="equalTo" /></ByValueCondition></Condition><Condition name="i2_parked_watchdog_ego_still_0" delay="0.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_1" delay="2.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_2" delay="4.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_3" delay="6.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_4" delay="8.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_5" delay="10.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_6" delay="12.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_7" delay="14.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_8" delay="16.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_9" delay="18.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_parked_watchdog_ego_still_10" delay="20.00" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><SpeedCondition value="0.1" rule="lessThan" /></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_van_contact" priority="parallel" maximumExecutionCount="1">
						<Action name="i2_van_contact_log"><UserDefinedAction><CustomCommandAction type="test(i2, contact, i2_van)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_van_contact_live" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="i2_parked_phase" value="1" rule="equalTo" /></ByValueCondition></Condition><Condition name="i2_van_hits_ego" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="i2_van" /></TriggeringEntities>
							<EntityCondition><CollisionCondition><EntityRef entityRef="ego" /></CollisionCondition></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_parked_contact" priority="parallel" maximumExecutionCount="1">
						<Action name="i2_parked_contact_log"><UserDefinedAction><CustomCommandAction type="test(i2, contact, i2_parked)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_parked_contact_live" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="i2_parked_phase" value="1" rule="equalTo" /></ByValueCondition></Condition><Condition name="i2_parked_hits_ego" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="i2_parked" /></TriggeringEntities>
							<EntityCondition><CollisionCondition><EntityRef entityRef="ego" /></CollisionCondition></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event>
				</Maneuver>
			</ManeuverGroup><ManeuverGroup maximumExecutionCount="1" name="i2_ped">
				<Actors selectTriggeringEntities="false"><EntityRef entityRef="i2_ped" /></Actors>
				<Maneuver name="i2_ped_m">
					<Event name="i2_ped_start" priority="parallel" maximumExecutionCount="1">
						<Action name="add_i2_ped"><GlobalAction><EntityAction entityRef="i2_ped"><AddEntityAction><Position><WorldPosition x="-5.6" y="-200.96" z="0.00" h="0.0000" p="0" r="0" /></Position></AddEntityAction></EntityAction></GlobalAction></Action><Action name="i2_ped_start_live"><GlobalAction><ParameterAction parameterRef="i2_ped_phase"><SetAction value="1" /></ParameterAction></GlobalAction></Action><Action name="i2_ped_start_log"><UserDefinedAction><CustomCommandAction type="test(i2, start, i2_ped)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_trigger_ped" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><ReachPositionCondition tolerance="3.0"><Position><WorldPosition x="-2.05" y="-49.96" z="0.00" h="-1.5712" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
						</ByEntityCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_ped_dart" priority="parallel" maximumExecutionCount="1">
						<Action name="i2_ped_walk"><PrivateAction><LongitudinalAction><SpeedAction>
							<SpeedActionDynamics dynamicsShape="linear" value="1.5" dynamicsDimension="rate" />
							<SpeedActionTarget><AbsoluteTargetSpeed value="1.5" /></SpeedActionTarget>
						</SpeedAction></LongitudinalAction></PrivateAction></Action><Action name="i2_dart"><PrivateAction><RoutingAction><FollowTrajectoryAction initialDistanceOffset="0">
							<TimeReference><Timing domainAbsoluteRelative="relative" offset="0" scale="1" /></TimeReference>
							<TrajectoryFollowingMode followingMode="position" />
							<TrajectoryRef><Trajectory name="i2_dart_path" closed="false"><ParameterDeclarations />
								<Shape><Polyline><Vertex><Position><WorldPosition x="-5.6" y="-200.96" z="0.00" h="0.0000" p="0" r="0" /></Position></Vertex><Vertex><Position><WorldPosition x="-2.4" y="-200.96" z="0.00" h="0.0000" p="0" r="0" /></Position></Vertex></Polyline></Shape>
							</Trajectory></TrajectoryRef>
						</FollowTrajectoryAction></RoutingAction></PrivateAction></Action><Action name="i2_dart_running"><GlobalAction><ParameterAction parameterRef="i2_ped_busy"><SetAction value="1" /></ParameterAction></GlobalAction></Action><Action name="i2_dart_log"><UserDefinedAction><CustomCommandAction type="test(i2, dart, i2_ped)" /></UserDefinedAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_ego_near" delay="0" conditionEdge="none"><ByEntityCondition>
							<TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities>
							<EntityCondition><ReachPositionCondition tolerance="2.0"><Position><WorldPosition x="-2.03" y="-140.96" z="0.00" h="-1.5704" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition>
						</ByEntityCondition></Condition><Condition name="i2_dart_live" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="i2_ped_phase" value="1" rule="equalTo" /></ByValueCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_ped_hold" priority="parallel" maximumExecutionCount="1">
						<Action name="i2_ped_stop"><PrivateAction><LongitudinalAction><SpeedAction>
							<SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time" />
							<SpeedActionTarget><AbsoluteTargetSpeed value="0.0" /></SpeedActionTarget>
						</SpeedAction></LongitudinalAction></PrivateAction></Action>
						<StartTrigger><ConditionGroup><Condition name="i2_ped_in_lane" delay="0" conditionEdge="none"><ByValueCondition>
							<StoryboardElementStateCondition storyboardElementType="event" storyboardElementRef="i2_ped_dart" state="completeState" />
						</ByValueCondition></Condition></ConditionGroup></StartTrigger>
					</Event><Event name="i2_ped_cross" priority="parallel" maximumExecutionCount="1">
						<Action name="i2_ped_walk_on"><PrivateAction><LongitudinalAction><SpeedAction>
							<SpeedActionDynamics dynamicsShape="linear" value="1.5" dynamicsDimension="rate" />
							<SpeedActionTarget><AbsoluteTargetSpeed value="1.5" /></SpeedActionTarget>
						</SpeedAction></LongitudinalAction></PrivateAction></Action><Action name="i2_cross"><PrivateAction><RoutingAction><FollowTrajectoryAction initialDistanceOffset="0">
							<TimeReference><Timing domainAbsoluteRelative="relative" offset="0" scale="1" /></TimeReference>
							<TrajectoryFollowingMode followingMode="position" />
							<TrajectoryRef><Trajectory name="i2_cross_path" closed="false"><ParameterDeclarations />
								<Shape><Polyline><Vertex><Position><WorldPosition x="-2.3" y="-200.96" z="0.00" h="0.0000" p="0" r="0" /></Position></Vertex><Vertex><Position><WorldPosition x="4.6" y="-200.96" z="0.00" h="0.0000" p="0" r="0" /></Position></Vertex></Polyline></Shape>
