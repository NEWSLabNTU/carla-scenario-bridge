<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>swb_examples</name>
  <version>0.1.0</version>
  <description>Starter scenarios for scenario-world-bridge: this project's Town01/Town02 scenarios and AWF ODD use cases</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>swb_launch</exec_depend>
  <!-- the vehicle catalog the scenarios refer to: $(find-pkg-share sim_vehicle_spec)/catalogs -->
  <exec_depend>sim_vehicle_spec</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
