							</Trajectory></TrajectoryRef>
						</FollowTrajectoryAction></RoutingAction></PrivateAction></Action>
						<StartTrigger><ConditionGroup><Condition name="p_close_1_added" delay="0.5" conditionEdge="none"><ByValueCondition>
