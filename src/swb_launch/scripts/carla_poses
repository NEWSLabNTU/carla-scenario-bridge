#!/usr/bin/env python3
"""Find poses on the CARLA map for a scenario, printed as OpenSCENARIO WorldPositions.

Scenarios give positions in the ROS frame of the Autoware map, which for the CARLA towns is
CARLA's world with y flipped and the heading negated (CARLA is left-handed). This tool reads
the map CARLA has loaded and prints poses already converted, ready to paste into a .xosc:

  ros2 run swb_launch carla_poses spawn-points            # CARLA's spawn points, numbered
  ros2 run swb_launch carla_poses ahead 12 --distance 70  # 70 m along the lane from #12
  ros2 run swb_launch carla_poses at 190.8 -130.1         # snap a ROS x/y onto its lane

It only reads the world: no actor is spawned and no setting is changed, so it is safe beside
a running scenario. Maps not in CARLA's frame (carla/map_origin.yaml) are not handled.
"""
import argparse
import math
import signal
import sys

try:
    import carla
except ImportError:
    sys.exit("carla_poses: the CARLA Python API is needed: pip install carla==<your CARLA version>")


def ros_pose(transform):
    """CARLA transform -> (x, y, z, heading rad) in the ROS frame."""
    loc, rot = transform.location, transform.rotation
    heading = math.atan2(math.sin(-math.radians(rot.yaw)), math.cos(-math.radians(rot.yaw)))
    return loc.x, -loc.y, loc.z, heading


def world_position(transform):
    x, y, z, h = ros_pose(transform)
    return f'<WorldPosition x="{x:.2f}" y="{y:.2f}" z="{z:.2f}" h="{h:.5f}" p="0" r="0" />'


def lane_note(wp):
    return f"road {wp.road_id} lane {wp.lane_id}{' (junction)' if wp.is_junction else ''}"


def connect(args):
    client = carla.Client(args.host, args.port)
    client.set_timeout(20.0)
    world = client.get_world()
    town = world.get_map().name.split("/")[-1]
    print(f"# CARLA {client.get_server_version()} at {args.host}:{args.port}, map {town}")
    return world.get_map()


def cmd_spawn_points(m, args):
    for i, sp in enumerate(m.get_spawn_points()):
        wp = m.get_waypoint(sp.location)
        print(f"{i:4d}  {world_position(sp)}  <!-- {lane_note(wp)} -->")


def cmd_ahead(m, args):
    points = m.get_spawn_points()
    if not 0 <= args.index < len(points):
        sys.exit(f"carla_poses: spawn point {args.index} out of range (0..{len(points) - 1})")
    wp = m.get_waypoint(points[args.index].location)
    print(f"start  {world_position(wp.transform)}  <!-- spawn point {args.index}, {lane_note(wp)} -->")
    travelled = 0.0
    while travelled < args.distance:
        step = min(args.step, args.distance - travelled)
        nxt = wp.next(step)
        if not nxt:
            print(f"# the lane ends after {travelled:.0f} m")
            break
        # At a junction keep the branch closest to straight ahead, unless --turn.
        def bend(w):
            return abs((w.transform.rotation.yaw - wp.transform.rotation.yaw + 180) % 360 - 180)
        wp = (max if args.turn else min)(nxt, key=bend)
        travelled += step
        if args.every and travelled < args.distance:
            print(f"{travelled:5.0f}m {world_position(wp.transform)}  <!-- {lane_note(wp)} -->")
    print(f"end    {world_position(wp.transform)}  <!-- {travelled:.0f} m on, {lane_note(wp)} -->")


def cmd_at(m, args):
    wp = m.get_waypoint(carla.Location(x=args.x, y=-args.y, z=0.0), project_to_road=True)
    off = math.hypot(wp.transform.location.x - args.x, -wp.transform.location.y - args.y)
    print(f"lane   {world_position(wp.transform)}  <!-- {off:.2f} m from the given point, {lane_note(wp)} -->")


def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `| head` ends quietly
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", default="localhost")
    ap.add_argument("--port", type=int, default=2000)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("spawn-points", help="list CARLA's spawn points as WorldPositions")
    a = sub.add_parser("ahead", help="the lane pose some distance along the road from a spawn point")
    a.add_argument("index", type=int, help="spawn point number (from spawn-points)")
    a.add_argument("--distance", type=float, default=50.0, help="metres along the lane (default 50)")
    a.add_argument("--step", type=float, default=2.0, help="waypoint step, m (default 2)")
    a.add_argument("--turn", action="store_true", help="at junctions take the sharpest turn, not the straightest")
    a.add_argument("--every", action="store_true", help="also print every step on the way")
    t = sub.add_parser("at", help="snap a ROS-frame x/y to the nearest driving lane")
    t.add_argument("x", type=float)
    t.add_argument("y", type=float)
    args = ap.parse_args()
    m = connect(args)
    {"spawn-points": cmd_spawn_points, "ahead": cmd_ahead, "at": cmd_at}[args.cmd](m, args)


if __name__ == "__main__":
    main()
