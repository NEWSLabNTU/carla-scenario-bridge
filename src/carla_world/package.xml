<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_world</name>
  <version>0.1.0</version>
  <description>The CARLA world server: CARLA behind the world protocol, for the scenario bridge (roadmap 046)</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- libclang for carla-rust's autocxx bindings, protoc for prost-build (csb_core's
       protocols), libzmq for the world protocol's socket. -->
  <build_depend>libclang-dev</build_depend>
  <build_depend>protobuf-dev</build_depend>
  <depend>libzmq3-dev</depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
