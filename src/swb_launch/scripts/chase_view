#!/usr/bin/env python3
"""Chase camera on the hero vehicle, shown in a pygame window (for demos and screencasts).

  ros2 run swb_launch chase_view          # VIEW_W/VIEW_H size, SDL_VIDEO_WINDOW_POS=x,y place it

The camera is NOT attached to the vehicle (a destroyed vehicle must never leave sensors
behind); it is a free sensor moved behind the hero on every world tick.
"""
import math
import os
import sys
import threading
import time

import carla
import numpy as np
import pygame

W, H = int(os.environ.get("VIEW_W", 800)), int(os.environ.get("VIEW_H", 450))
TITLE = os.environ.get("VIEW_TITLE", "CARLA")
os.environ.setdefault("SDL_VIDEO_WINDOW_POS", "0,0")

client = carla.Client("localhost", int(os.environ.get("CARLA_PORT", 2000)))
client.set_timeout(20.0)

frame = {"img": None}
lock = threading.Lock()
state = {"world_id": None, "cam": None, "hero": None, "tick_cb": None, "world": None}


def on_image(image):
    frame["n"] = frame.get("n", 0) + 1
    if frame["n"] % 100 == 1:
        print(f"[chase_view] image {frame['n']} frame {image.frame}", file=sys.stderr, flush=True)
    a = np.frombuffer(image.raw_data, dtype=np.uint8).reshape((image.height, image.width, 4))
    with lock:
        frame["img"] = a[:, :, 2::-1].swapaxes(0, 1).copy()


def chase_tf(tf):
    yaw = math.radians(tf.rotation.yaw)
    loc = tf.location + carla.Location(x=-9.0 * math.cos(yaw), y=-9.0 * math.sin(yaw), z=4.5)
    return carla.Transform(loc, carla.Rotation(pitch=-15.0, yaw=tf.rotation.yaw))


def on_tick(_snap):
    hero, cam = state["hero"], state["cam"]
    if hero is None or cam is None:
        return
    try:
        cam.set_transform(chase_tf(hero.get_transform()))
    except RuntimeError:
        pass


def teardown():
    cam = state["cam"]
    if cam is not None:
        try:
            cam.stop()
            cam.destroy()
        except RuntimeError:
            pass
    if state["world"] is not None and state["tick_cb"] is not None:
        try:
            state["world"].remove_on_tick(state["tick_cb"])
        except RuntimeError:
            pass
    state.update(cam=None, hero=None, tick_cb=None)


def ensure():
    world = client.get_world()
    if world.id != state["world_id"]:
        print(f"[chase_view] new world {world.id}", file=sys.stderr, flush=True)
        teardown()
        state.update(world=world, world_id=world.id)
    hero = None
    for v in world.get_actors().filter("vehicle.*"):
        if v.attributes.get("role_name") == "hero":
            hero = v
            break
    if hero is None:
        # No ego (e.g. a scenario that only changes the map): an overhead view of the town.
        if state["hero"] is not None or state["cam"] is None:
            teardown()
            spawn_cam(world, overview_tf(world))
        return
    if state["hero"] is None or state["hero"].id != hero.id:
        # A new scenario spawns a new ego: start over with a fresh camera.
        teardown()
        state["hero"] = hero
    if state["cam"] is None or not state["cam"].is_alive:
        spawn_cam(world, chase_tf(hero.get_transform()))
        print(f"[chase_view] camera on hero {hero.id} world {world.id}", file=sys.stderr, flush=True)
        state["tick_cb"] = world.on_tick(on_tick)


def overview_tf(world):
    sp = world.get_map().get_spawn_points()
    loc = sp[0].location if sp else carla.Location()
    return carla.Transform(loc + carla.Location(z=60.0), carla.Rotation(pitch=-60.0, yaw=sp[0].rotation.yaw if sp else 0.0))


def spawn_cam(world, tf):
    bp = world.get_blueprint_library().find("sensor.camera.rgb")
    bp.set_attribute("image_size_x", str(W))
    bp.set_attribute("image_size_y", str(H))
    bp.set_attribute("fov", "90")
    cam = world.spawn_actor(bp, tf)
    cam.listen(on_image)
    state["cam"] = cam


def main():
    pygame.init()
    screen = pygame.display.set_mode((W, H))
    pygame.display.set_caption(TITLE)
    font = pygame.font.SysFont("dejavusans", 18, bold=True)
    last = 0.0
    try:
        while True:
            for e in pygame.event.get():
                if e.type == pygame.QUIT:
                    return
            now = time.time()
            if now - last > 1.0:
                last = now
                try:
                    ensure()
                except RuntimeError as err:
                    print(f"[chase_view] {err}", file=sys.stderr)
            with lock:
                img = frame["img"]
            if img is not None:
                screen.blit(pygame.surfarray.make_surface(img), (0, 0))
            else:
                screen.fill((20, 20, 20))
                screen.blit(font.render("waiting for hero vehicle...", True, (200, 200, 200)), (20, 20))
            label = os.environ.get("VIEW_LABEL", "")
            try:
                label = open(os.environ["VIEW_LABEL_FILE"]).read().strip()
            except (KeyError, OSError):
                pass
            if label:
                txt = font.render(label, True, (255, 255, 255))
                bg = pygame.Surface((txt.get_width() + 16, txt.get_height() + 8))
                bg.set_alpha(160)
                screen.blit(bg, (8, 8))
                screen.blit(txt, (16, 12))
            pygame.display.flip()
            time.sleep(1 / 30)
    finally:
        teardown()


if __name__ == "__main__":
    main()
