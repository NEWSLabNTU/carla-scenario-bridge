#!/usr/bin/env bash
# csb's Isaac Sim world server as a launch node (roadmap 043; isaac_world.launch.xml).
#
#   isaac_world_server --port N --ego <yaml|none> --world <worlds|none> --follow <bool>
#                      --render <auto|window|headless> [--ros-args ...]
#
# The world server is Python 3.12 in Isaac's venv with Isaac's own ROS 2 libraries
# (src/csb_isaac/scripts/isaac_env.sh); the system Humble a launch runs under must not leak
# into it, so its paths are dropped here first. The launch's --ros-args (node name, remaps)
# mean nothing to it and are dropped too.
#
# Environment: CSB_ISAAC_DIR (default: the csb_isaac this package was built beside),
# ISAAC_ROOT, DISPLAY (render auto/window), ISAAC_HEADLESS=1 (render auto: headless),
# CYCLONEDDS_URI (passed through: the ego stack's DDS).
set -e
csb_isaac="${CSB_ISAAC_DIR:-@CSB_ISAAC_DIR@}"
port=5590; ego=default; world=none; follow=false; render=auto
while [ $# -gt 0 ]; do
    case "$1" in
        --ros-args) break ;;
        --port) port="$2"; shift 2 ;;
        --ego) ego="$2"; shift 2 ;;
        --world) world="$2"; shift 2 ;;
        --follow) follow="$2"; shift 2 ;;
        --render) render="$2"; shift 2 ;;
        *) echo "isaac_world_server: unknown argument '$1'" >&2; exit 2 ;;
    esac
done

args=(--port "$port")
case "$ego" in
    default) args+=(--ego "$csb_isaac/config/acb_ego.yaml") ;;
    none|"") ;;
    *) args+=(--ego "$ego") ;;
esac
case "$world" in none|"") ;; *) args+=(--world "$world") ;; esac
case "$follow" in true|1) args+=(--follow) ;; esac
display="${DISPLAY:-}"
case "$render" in
    auto) [ -n "${ISAAC_HEADLESS:-}" ] && [ "${ISAAC_HEADLESS}" != 0 ] && display="" ;;
    window) [ -n "$display" ] || { echo "isaac_world_server: render window needs DISPLAY" >&2; exit 2; } ;;
    headless) display="" ;;
    *) echo "isaac_world_server: render '$render' is not auto, window or headless" >&2; exit 2 ;;
esac
[ -n "$display" ] && args+=(--display "$display")

# The system ROS 2 environment out, Isaac's in.
unset PYTHONPATH PYTHONHOME LD_LIBRARY_PATH AMENT_PREFIX_PATH CMAKE_PREFIX_PATH \
    COLCON_PREFIX_PATH PKG_CONFIG_PATH ROS_PACKAGE_PATH ROS_LOCALHOST_ONLY ROS_VERSION \
    ROS_PYTHON_VERSION VIRTUAL_ENV
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v '^/opt/ros/\|^/opt/autoware/\|/install/' | paste -sd:)
export ISAAC_ROOT="${ISAAC_ROOT:-/mnt/disk1/isaac-sim}"
export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# shellcheck source=/dev/null
source "$csb_isaac/scripts/isaac_env.sh"
cd "$csb_isaac"
echo "isaac_world_server: python -m csb_isaac.world_server ${args[*]}"
exec python -u -m csb_isaac.world_server "${args[@]}"
